 /* Profile destination */
 
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__layout--profile {
+  gap: 0;
+}
+
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__profile-page-detail {
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+  padding: 26px 40px;
+  border: none;
+  border-radius: 22px;
+  background: var(--surface-card, #121212);
+  color: var(--text-main);
+}
+
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__profile-page-detail > .pwa-navigation-placeholder__profile-title {
+  width: min(58vw, 320px);
+  height: 33px;
+  border-radius: 999px;
+}
+
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__profile-weight-block {
+  align-self: flex-start;
+  min-width: 140px;
+  padding: 14px 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  border: none;
+  border-radius: 16px;
+  background: var(--surface-card-muted, #202020);
+}
+
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__profile-weight-block span {
+  width: 76px;
+  height: 12px;
+  border-radius: 999px;
+}
+
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__profile-weight-block strong {
+  width: 92px;
+  height: 22px;
+  border-radius: 999px;
+}
+
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__profile-data-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 10px;
+}
+
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__profile-data-block {
+  min-width: 0;
+  padding: 14px 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  border: none;
+  border-radius: 14px;
+  background: var(--surface-card-muted, #202020);
+}
+
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__profile-data-block span {
+  width: 70%;
+  height: 11px;
+  border-radius: 999px;
+}
+
+html.pwa-standalone.pwa-is-navigating .pwa-navigation-placeholder__profile-data-block strong {
+  width: 92%;
+  height: 14px;
+  border-radius: 999px;
+}
+
