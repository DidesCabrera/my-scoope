diff -ruN proyecto_django_export_full_orig/notas/tests/test_performance_query_patterns.py proyecto_django_export_full/notas/tests/test_performance_query_patterns.py
--- proyecto_django_export_full_orig/notas/tests/test_performance_query_patterns.py	1970-01-01 00:00:00.000000000 +0000
