diff --git a/notas/static/notas/css/components/programs.css b/notas/static/notas/css/components/programs.css
index fb1e734..3b2f880 100644
--- a/notas/static/notas/css/components/programs.css
+++ b/notas/static/notas/css/components/programs.css
@@ -1343,3 +1343,80 @@
     display: none;
   }
 }
+
+/* Program weekly aggregation refinements ======================= */
+.program-main-title-card {
+  margin-bottom: 1rem;
+}
+
+.program-main-title-card .card-title-comp {
+  padding: 6px 4px;
+}
+
+.program-main-title-card .main-title h1 {
+  margin: 0 0 0.35rem;
+  color: var(--text-main);
+  font-size: clamp(1.45rem, 3vw, 2rem);
+  font-weight: 750;
+  line-height: 1.08;
+}
+
+.program-main-title-card .structural-indicators,
+.program-card .structural-indicators {
+  width: fit-content;
+}
+
+.program-main-title-card .program-structural-icon,
+.program-card .program-structural-icon,
+.program-board-header .program-structural-icon {
+  width: 18px;
+  height: 18px;
+  padding: 3px;
+  border-radius: 5px;
+}
+
+.program-week-row__meta {
+  display: inline-flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 0.75rem;
+  min-width: 0;
+}
+
+.program-week-row__indicators {
+  flex: 0 0 auto;
+}
+
+.program-week-row__foods-row {
+  min-width: 0;
+}
+
+.program-week-foods-aggregation {
+  margin: 0;
+  overflow: hidden;
+}
+
+.program-week-foods-aggregation .card-detail-tabs,
+.program-week-foods-aggregation .card-detail-tabs-mobile {
+  margin-bottom: 0.55rem;
+}
+
+.program-week-foods-aggregation .data-grid {
+  margin: 0;
+}
+
+.program-week-foods-aggregation .data-grid-empty {
+  margin: 0;
+}
+
+@media (max-width: 780px) {
+  .program-week-row__meta {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 0.4rem;
+  }
+
+  .program-main-title-card .card-title-comp {
+    gap: 0.75rem;
+  }
+}
