+        return payload["meal"].get("name") or "Comida propuesta"
+
+    if payload.get("is_create_dailyplan") and payload.get("dailyplan"):
+        return payload["dailyplan"].get("name") or "DailyPlan propuesto"
+
+    return "Entidad propuesta"
