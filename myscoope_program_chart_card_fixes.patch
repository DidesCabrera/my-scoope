diff --git a/notas/static/notas/css/components/programs.css b/notas/static/notas/css/components/programs.css
index d043211..bb3df13 100644
--- a/notas/static/notas/css/components/programs.css
+++ b/notas/static/notas/css/components/programs.css
@@ -2424,3 +2424,79 @@
     font-size: 0.54rem;
   }
 }
+
+/* Program chart refinements: tabs, calories color, stacked values ============ */
+.program-chart-panel {
+  --program-chart-calories-color: #d99a5a;
+}
+
+.program-chart-tabs {
+  width: fit-content;
+  padding: 10px;
+  gap: 6px;
+  align-self: flex-start;
+}
+
+.program-chart-tab {
+  height: 22px;
+  min-height: 22px;
+  padding: 0 8px;
+  border-radius: 12px;
+  font-size: 13px;
+  font-weight: 450;
+  line-height: 1;
+  transition:
+    background-color 0.2s ease,
+    color 0.2s ease,
+    border-color 0.2s ease,
+    opacity 0.2s ease;
+}
+
+.program-chart-plot--calories .program-chart-bar {
+  background: var(--program-chart-calories-color);
+}
+
+.program-chart-stacked-bar__segment {
+  position: relative;
+  display: grid;
+  place-items: center;
+  overflow: hidden;
+}
+
+.program-chart-segment-value {
+  z-index: 1;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  min-width: 0;
+  padding: 0 2px;
+  color: var(--text-inverted);
+  font-size: 0.54rem;
+  font-weight: 850;
+  line-height: 1;
+  text-align: center;
+  text-shadow: 0 1px 2px color-mix(in srgb, #000 64%, transparent);
+  white-space: nowrap;
+  pointer-events: none;
+}
+
+.program-chart-panel--week .program-chart-segment-value {
+  font-size: 0.56rem;
+}
+
+@media (max-width: 780px) {
+  .program-chart-panel--week .program-chart-week-axis span {
+    font-size: 0;
+  }
+
+  .program-chart-panel--week .program-chart-week-axis span::after {
+    content: attr(data-mobile-label);
+    font-size: 0.58rem;
+  }
+
+  .program-chart-segment-value,
+  .program-chart-panel--week .program-chart-segment-value {
+    font-size: 0.46rem;
+  }
+}
