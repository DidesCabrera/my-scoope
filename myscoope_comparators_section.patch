diff --git a/notas/templates/notas/comparators/detail.html b/notas/templates/notas/comparators/detail.html
new file mode 100644
index 0000000..9fcbc64
--- /dev/null
+++ b/notas/templates/notas/comparators/detail.html
@@ -0,0 +1,124 @@
+{% extends "notas/base.html" %}
+{% load static l10n %}
+{% block title %}Comparadores{% endblock %}
+{% block content %}
+
+<div class="page list comparator-page">
+  {% include "components/list_page_header.html" %}
+
+  <nav class="comparator-tabs" aria-label="Tipo de comparador">
+    {% for tab in vm.content.tabs %}
+      <a href="{{ tab.url }}" class="comparator-tab {% if tab.is_active %}is-active{% endif %}">
+        <i data-lucide="{{ tab.icon }}" class="comparator-tab__icon"></i>
+        <span>{{ tab.label }}</span>
+      </a>
+    {% endfor %}
+  </nav>
+
+  <form method="get" class="comparator-form card-detail-block" data-comparator-form>
+    <div class="comparator-selectors">
+      <section class="comparator-selector" data-comparator-selector>
+        <div class="comparator-selector__heading">
+          <span class="comparator-selector__badge">1</span>
+          <div>
+            <p>{{ vm.content.selector_a_label }}</p>
+            {% if vm.content.selection_a.name %}<strong>{{ vm.content.selection_a.name }}</strong>{% endif %}
+          </div>
+        </div>
+
+        <label class="comparator-field">
+          <span>{{ vm.content.selector_label }}</span>
+          <select name="a" data-comparator-select>
+            <option value="">Seleccionar {{ vm.content.entity_label }}</option>
+            {% for choice in vm.content.choices %}
+              <option value="{{ choice.id }}" {% if choice.id == vm.content.selection_a.id %}selected{% endif %}>{{ choice.name }}</option>
+            {% endfor %}
+          </select>
+        </label>
+
+        {% if vm.content.show_quantity_inputs %}
+          <label class="comparator-field comparator-field--quantity {% if not vm.content.selection_a.id %}is-hidden{% endif %}" data-comparator-quantity>
+            <span>Cantidad</span>
+            <input type="number" name="qty_a" min="1" step="1" value="{{ vm.content.selection_a.quantity|floatformat:0 }}">
+            <em>{{ vm.content.quantity_unit }}</em>
+          </label>
+        {% endif %}
+      </section>
+
+      <section class="comparator-selector" data-comparator-selector>
+        <div class="comparator-selector__heading">
+          <span class="comparator-selector__badge">2</span>
+          <div>
+            <p>{{ vm.content.selector_b_label }}</p>
+            {% if vm.content.selection_b.name %}<strong>{{ vm.content.selection_b.name }}</strong>{% endif %}
+          </div>
+        </div>
+
+        <label class="comparator-field">
+          <span>{{ vm.content.selector_label }}</span>
+          <select name="b" data-comparator-select>
+            <option value="">Seleccionar {{ vm.content.entity_label }}</option>
+            {% for choice in vm.content.choices %}
+              <option value="{{ choice.id }}" {% if choice.id == vm.content.selection_b.id %}selected{% endif %}>{{ choice.name }}</option>
+            {% endfor %}
+          </select>
+        </label>
+
+        {% if vm.content.show_quantity_inputs %}
+          <label class="comparator-field comparator-field--quantity {% if not vm.content.selection_b.id %}is-hidden{% endif %}" data-comparator-quantity>
+            <span>Cantidad</span>
+            <input type="number" name="qty_b" min="1" step="1" value="{{ vm.content.selection_b.quantity|floatformat:0 }}">
+            <em>{{ vm.content.quantity_unit }}</em>
+          </label>
+        {% endif %}
+      </section>
+    </div>
+
+    <div class="comparator-form__actions">
+      <button type="submit" class="btn-primary">Comparar</button>
+    </div>
+  </form>
+
+  {% if vm.content.is_ready %}
+    <section class="comparator-results" aria-label="Resultados comparativos">
+      {% for metric in vm.content.metrics %}
+        <article class="comparator-metric comparator-metric--{{ metric.key }} card-detail-block">
+          <header class="comparator-metric__header">
+            <h3>{{ metric.label }}</h3>
+            <span>{{ metric.unit }}</span>
+          </header>
+
+          <div class="comparator-bars">
+            <div class="comparator-bar-row comparator-bar-row--a">
+              <div class="comparator-bar-row__meta">
+                <strong>{{ vm.content.selection_a.name }}</strong>
+                <span>{{ metric.a.formatted_value }}</span>
+              </div>
+              <div class="comparator-bar-track">
+                <span class="comparator-bar comparator-bar--a" style="width: {{ metric.a.width|unlocalize }}%;"></span>
+              </div>
+            </div>
+
+            <div class="comparator-bar-row comparator-bar-row--b">
+              <div class="comparator-bar-row__meta">
+                <strong>{{ vm.content.selection_b.name }}</strong>
+                <span>{{ metric.b.formatted_value }}</span>
+              </div>
+              <div class="comparator-bar-track">
+                <span class="comparator-bar comparator-bar--b" style="width: {{ metric.b.width|unlocalize }}%;"></span>
+              </div>
+            </div>
+          </div>
+        </article>
+      {% endfor %}
+    </section>
+  {% else %}
+    <section class="comparator-empty card-detail-block">
+      <i data-lucide="columns-3" class="comparator-empty__icon"></i>
+      <p>{{ vm.content.empty_message }}</p>
+    </section>
+  {% endif %}
+</div>
+
+<script src="{% static 'notas/js/comparators.js' %}"></script>
+{% endblock %}
