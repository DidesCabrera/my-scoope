+
+/* Program chart / panels final refinements ======================= */
+.structural-indicators .program-structural-icon {
+  width: 13px !important;
+  height: 13px !important;
+  padding: 0 !important;
+  border-radius: 0 !important;
+  background: transparent !important;
+  color: var(--text-muted) !important;
+  stroke: currentColor !important;
+  stroke-width: 2 !important;
+}
+
+.program-card__title-block.card-title {
+  width: 100%;
+  margin-right: 0;
+}
+
+.program-card .card-title-link,
+.program-card .card-title-link h3,
+.program-main-title-card .main-title.main-card,
+.program-main-title-card .main-title h1 {
+  width: 100%;
+  max-width: 100%;
+}
+
+.program-card .card-title-comp .main-title,
+.program-main-title-card .card-title-comp .main-title {
+  flex: 1 1 100%;
+  min-width: 0;
+}
+
+.program-chart-panel {
+  border-radius: 8px;
+}
+
+.program-chart-panel__heading {
+  display: block;
+}
+
+.program-chart-panel__header span {
+  display: none;
+}
+
+.program-chart-range-label {
+  margin: 0 0 0.35rem;
+  color: var(--text-muted);
+  font-size: 0.66rem;
+  font-weight: 650;
+  letter-spacing: 0.02em;
+}
+
+.program-chart-layout {
+  display: block;
+}
+
+.program-chart-main-axis {
+  display: grid;
+  gap: 0.3rem;
+}
+
+.program-chart-plot {
+  position: relative;
+  isolation: isolate;
+  background: color-mix(in srgb, var(--surface-card-muted) 72%, transparent);
+}
+
+.program-chart-guide {
+  position: absolute;
+  left: 0.2rem;
+  right: 0.2rem;
+  z-index: 0;
+  display: block;
+  height: 1px;
+  pointer-events: none;
+  background: color-mix(in srgb, var(--border-default) 54%, transparent);
+}
+
+.program-chart-guide--max {
+  top: 0.65rem;
+}
+
+.program-chart-guide--min {
+  bottom: 0.2rem;
+}
+
+.program-chart-bar-slot {
+  z-index: 1;
+}
+
+.program-card-panels__desktop-tabs {
+  padding: 0 0 0.55rem;
+}
+
+.program-card-panels__desktop.card-table-programs {
+  padding: 0;
+}
+
+.data-grid--program-weeks .program-week-table__macro--protein,
+.data-grid--program-weeks .program-week-table__macro--carbs,
+.data-grid--program-weeks .program-week-table__macro--fat {
+  color: #ffffff;
+  font-weight: 450;
+}
+
+@media (min-width: 981px) {
+  .program-card-panels .card-detail-tabs-mobile,
+  .program-card-panels .card-table-programs-mobile {
+    display: none !important;
+    opacity: 0 !important;
+  }
+
+  .program-card-panels__desktop-tabs {
+    display: flex !important;
+  }
+
+  .program-card-panels__desktop {
+    display: none !important;
+    opacity: 0 !important;
+  }
+
+  .program-card-panels__desktop.is-visible {
+    display: block !important;
+    opacity: 1 !important;
+  }
+}
+
+@media (max-width: 980px) {
+  .program-card-panels__desktop-tabs {
+    display: none !important;
+  }
+}
