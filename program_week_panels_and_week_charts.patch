diff --git a/notas/templates/components/program_week_panels.html b/notas/templates/components/program_week_panels.html
new file mode 100644
index 0000000..8c81d23
--- /dev/null
+++ b/notas/templates/components/program_week_panels.html
@@ -0,0 +1,49 @@
+{% if weeks %}
+<div
+  class="card-detail-block program-card-panels"
+  data-default-desktop="#card-grid-program-macros-{{ panel_id }}"
+  data-default-mobile="#card-grid-program-macros-mobile-{{ panel_id }}"
+>
+  <div class="card-detail-tabs card-detail-tabs--desktop block-desplegar-tabla block-card-desplegar">
+    <div class="btn-desplegar" data-target="#card-grid-program-macros-{{ panel_id }}">
+      <p>Macros</p>
+    </div>
+    <div class="btn-desplegar" data-target="#card-grid-program-alloc-{{ panel_id }}">
+      <p>Alloc</p>
+    </div>
+  </div>
+
+  <div class="card-detail-tabs-mobile">
+    <button
+      type="button"
+      class="btn-desplegar-mobile"
+      data-target="#card-grid-program-macros-mobile-{{ panel_id }}"
+    >
+      Macros
+    </button>
+    <button
+      type="button"
+      class="btn-desplegar-mobile"
+      data-target="#card-grid-program-alloc-mobile-{{ panel_id }}"
+    >
+      Alloc
+    </button>
+  </div>
+
+  <div id="card-grid-program-macros-{{ panel_id }}" class="card-table-programs program-table-panel">
+    {% include "components/program_week_table_macros.html" with weeks=weeks %}
+  </div>
+
+  <div id="card-grid-program-alloc-{{ panel_id }}" class="card-table-programs program-table-panel">
+    {% include "components/program_week_table_alloc.html" with weeks=weeks %}
+  </div>
+
+  <div id="card-grid-program-macros-mobile-{{ panel_id }}" class="card-table-programs-mobile program-table-panel">
+    {% include "components/program_week_table_macros.html" with weeks=weeks %}
+  </div>
+
+  <div id="card-grid-program-alloc-mobile-{{ panel_id }}" class="card-table-programs-mobile program-table-panel">
+    {% include "components/program_week_table_alloc.html" with weeks=weeks %}
+  </div>
+</div>
+{% endif %}
diff --git a/notas/templates/components/program_week_table_alloc.html b/notas/templates/components/program_week_table_alloc.html
