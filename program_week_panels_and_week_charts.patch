+++ b/notas/templates/components/program_week_table_alloc.html
@@ -0,0 +1,17 @@
+<div class="program-week-table" role="table" aria-label="Alloc por semana">
+  <div class="program-week-table__row program-week-table__row--header" role="row">
+    <span role="columnheader">Semana</span>
+    <span role="columnheader">P%</span>
+    <span role="columnheader">C%</span>
+    <span role="columnheader">F%</span>
+  </div>
+
+  {% for week in weeks %}
+    <div class="program-week-table__row program-week-table__row--alloc" role="row">
+      <strong role="cell">S{{ week.week_number }}</strong>
+      <span role="cell" class="program-week-table__macro program-week-table__macro--protein">{{ week.totals.alloc.protein|floatformat:0 }}%</span>
+      <span role="cell" class="program-week-table__macro program-week-table__macro--carbs">{{ week.totals.alloc.carbs|floatformat:0 }}%</span>
+      <span role="cell" class="program-week-table__macro program-week-table__macro--fat">{{ week.totals.alloc.fat|floatformat:0 }}%</span>
+    </div>
+  {% endfor %}
+</div>
