--- a/notas/static/notas/css/components/programs.css
+++ b/notas/static/notas/css/components/programs.css
@@ -2794,3 +2794,172 @@
     padding-inline: 0;
   }
 }
+
+/* Program chart fixed geometry by business week count ===================== */
+.program-chart-panel {
+  --program-chart-calories-color: #7b5b39;
+  --program-chart-week-width: 128px;
+  --program-chart-bar-width: 12px;
+  --program-chart-week-border: color-mix(in srgb, var(--border-default) 62%, transparent);
+}
+
+.program-chart-plot--calories .program-chart-bar {
+  background: var(--program-chart-calories-color);
+}
+
+.program-chart-main-axis--program {
+  overflow-x: auto;
+  overflow-y: hidden;
+}
+
+.program-chart-main-axis--program .program-chart-plot,
+.program-chart-main-axis--program .program-chart-week-axis {
+  box-sizing: border-box;
+  width: max-content;
+  min-width: max-content;
+  padding-inline: 0;
+}
+
+.program-chart-main-axis--program .program-chart-plot {
+  display: flex;
+  align-items: stretch;
+  gap: 0;
+  background:
+    linear-gradient(to top, color-mix(in srgb, var(--border-default) 42%, transparent) 1px, transparent 1px) 0 0 / 100% 25%,
+    var(--surface-card);
+}
+
+.program-chart-main-axis--program .program-chart-week-column {
+  box-sizing: border-box;
+  flex: 0 0 var(--program-chart-week-width);
+  width: var(--program-chart-week-width);
+  display: grid;
+  grid-template-columns: repeat(7, minmax(0, 1fr));
+  column-gap: 0;
+  align-items: end;
+  min-width: var(--program-chart-week-width);
+  max-width: var(--program-chart-week-width);
+  height: 100%;
+  padding-inline: 0;
+  border-left: 1px solid var(--program-chart-week-border);
+  border-right: 1px solid var(--program-chart-week-border);
+}
+
+.program-chart-main-axis--program .program-chart-week-column:first-of-type {
+  border-left: 0;
+}
+
+.program-chart-main-axis--program .program-chart-week-column:last-of-type {
+  border-right: 0;
+}
+
+.program-chart-main-axis--program .program-chart-bar-slot {
+  min-width: 0;
+  padding-inline: 0;
+  border-left: 0;
+}
+
+.program-chart-main-axis--program .program-chart-bar-slot.is-week-start {
+  border-left: 0;
+}
+
+.program-chart-main-axis--program .program-chart-bar,
+.program-chart-main-axis--program .program-chart-stacked-bar,
+.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-bar,
+.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-stacked-bar,
+.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-bar,
+.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-stacked-bar,
+.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-bar,
+.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-stacked-bar,
+.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-bar,
+.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-stacked-bar {
+  width: var(--program-chart-bar-width);
+  max-width: var(--program-chart-bar-width);
+}
+
+.program-chart-main-axis--program .program-chart-week-axis {
+  display: flex;
+  gap: 0;
+}
+
+.program-chart-main-axis--program .program-chart-week-axis span {
+  box-sizing: border-box;
+  flex: 0 0 var(--program-chart-week-width);
+  width: var(--program-chart-week-width);
+  min-width: var(--program-chart-week-width);
+  max-width: var(--program-chart-week-width);
+  padding-top: 0.18rem;
+  border-left: 1px solid var(--program-chart-week-border);
+  border-right: 1px solid var(--program-chart-week-border);
+  text-align: center;
+}
+
+.program-chart-main-axis--program .program-chart-week-axis span:first-child {
+  border-left: 0;
+}
+
+.program-chart-main-axis--program .program-chart-week-axis span:last-child {
+  border-right: 0;
+}
+
+.program-chart-main-axis--program[data-weeks-count="1"] {
+  --program-chart-week-width: 280px;
+  --program-chart-bar-width: 18px;
+}
+
+.program-chart-main-axis--program[data-weeks-count="2"] {
+  --program-chart-week-width: 210px;
+  --program-chart-bar-width: 18px;
+}
+
+.program-chart-main-axis--program[data-weeks-count="3"] {
+  --program-chart-week-width: 160px;
+  --program-chart-bar-width: 16px;
+}
+
+.program-chart-main-axis--program[data-weeks-count="4"] {
+  --program-chart-week-width: 128px;
+  --program-chart-bar-width: 13px;
+}
+
+.program-chart-main-axis--program[data-weeks-count="5"],
+.program-chart-main-axis--program[data-weeks-count="6"],
+.program-chart-main-axis--program[data-weeks-count="7"],
+.program-chart-main-axis--program[data-weeks-count="8"],
+.program-chart-main-axis--program[data-weeks-count="9"],
+.program-chart-main-axis--program[data-weeks-count="10"],
+.program-chart-main-axis--program[data-weeks-count="11"],
+.program-chart-main-axis--program[data-weeks-count="12"] {
+  --program-chart-week-width: 128px;
+  --program-chart-bar-width: 13px;
+}
+
+@media (max-width: 780px) {
+  .program-chart-main-axis--program[data-weeks-count="1"] {
+    --program-chart-week-width: 236px;
+    --program-chart-bar-width: 18px;
+  }
+
+  .program-chart-main-axis--program[data-weeks-count="2"] {
+    --program-chart-week-width: 158px;
+    --program-chart-bar-width: 15px;
+  }
+
+  .program-chart-main-axis--program[data-weeks-count="3"] {
+    --program-chart-week-width: 112px;
+    --program-chart-bar-width: 11px;
+  }
+
+  .program-chart-main-axis--program[data-weeks-count="4"],
+  .program-chart-main-axis--program[data-weeks-count="5"],
+  .program-chart-main-axis--program[data-weeks-count="6"],
+  .program-chart-main-axis--program[data-weeks-count="7"],
+  .program-chart-main-axis--program[data-weeks-count="8"],
+  .program-chart-main-axis--program[data-weeks-count="9"],
+  .program-chart-main-axis--program[data-weeks-count="10"],
+  .program-chart-main-axis--program[data-weeks-count="11"],
+  .program-chart-main-axis--program[data-weeks-count="12"] {
+    --program-chart-week-width: 76px;
+    --program-chart-bar-width: 6px;
+  }
+}
