+{% extends "notas/base.html" %}
+{% block title %}Compartir / Inbox{% endblock %}
+{% block content %}
+
+<div class="page list inbox-list-page proposal-list-page">
+
+  {% include "components/list_page_header.html" %}
+
+  {% if vm.content.list_mode == "delete" %}
+    {% include "components/list_panel_inbox_delete.html" with inbox_items=vm.content.inbox_items %}
+  {% else %}
+    {% if vm.content.favorites_only %}
+      <div class="inbox-filter-chip">
+        <i data-lucide="star" class="metadata-icon"></i>
+        Mostrando favoritos
+      </div>
+    {% endif %}
+
+    {% for item in vm.content.inbox_items %}
+      <article class="card proposal-list-card inbox-list-card inbox-list-card--{{ item.kind }}{% if item.is_favorite %} is-favorite{% endif %}">
+        <div class="proposal-list-card__main">
+          <div class="proposal-list-card__title-block">
+            <div class="proposal-list-card__copy">
+              <h3 class="proposal-list-card__title inbox-list-card__title">{{ item.title }}</h3>
+            </div>
+          </div>
+
+          <p class="proposal-received-date proposal-list-card__received-date">
+            {{ item.received_at_label }} · {{ item.sender }}
+          </p>
+
+          <div class="proposal-list-card__icons-title" aria-hidden="true">
+            <i data-lucide="inbox" class="home-section-header-icon inbox"></i>
+          </div>
+        </div>
+
+        <span class="proposal-status-badge inbox-status-badge{% if item.is_favorite %} inbox-status-badge--favorite{% endif %}">
+          {% if item.is_favorite %}Favorito{% else %}Recibido{% endif %}
+        </span>
+
+        <div class="proposal-list-card__summary-block inbox-list-card__summary-block">
+          <span class="proposal-list-card__summary-label">Mensaje</span>
+          <p class="proposal-list-card__summary">{{ item.summary }}</p>
+        </div>
+
+        <div class="card-bottom proposal-list-card__bottom">
+          <i data-lucide="paperclip" class="proposal-list-card__attachment-paperclip" aria-hidden="true"></i>
+
+          <a href="{{ item.attachment.open_url }}" class="proposal-attachment proposal-attachment--{{ item.attachment.kind }} proposal-review-attachment inbox-attachment-link">
+            <span class="proposal-attachment__icon" aria-hidden="true">
+              <i data-lucide="{{ item.attachment.icon }}" class="proposal-attachment__svg"></i>
+            </span>
+            <span class="proposal-attachment__copy">
+              <strong class="proposal-attachment__name">{{ item.attachment.name }}</strong>
+            </span>
+          </a>
+
+          <div class="card-actions proposal-list-card__actions">
+            {% include "components/card_actions.html" with actions=item.actions %}
+          </div>
+        </div>
+      </article>
+    {% empty %}
+      <section class="card proposal-empty-card inbox-empty-card">
+        <div>
+          <h3>No tienes inbox recibidos.</h3>
+          <p>
+            Los elementos que otras personas compartan contigo aparecerán aquí después de abrir el enlace de invitación.
+          </p>
+        </div>
+      </section>
+    {% endfor %}
+  {% endif %}
+
+</div>
+
+{% load static %}
+<script src="{% static 'notas/js/list_panel_modes.js' %}"></script>
+
+{% endblock %}
