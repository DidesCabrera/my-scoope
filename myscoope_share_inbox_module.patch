+        <i data-lucide="paperclip" class="proposal-review-attachments-heading__icon"></i>
+        <h3>Adjuntos</h3>
+      </div>
+
+      <div class="proposal-review-attachments-list inbox-review-attachments-list">
+        <a href="{{ vm.content.inbox.attachment.open_url }}" class="proposal-attachment proposal-attachment--{{ vm.content.inbox.attachment.kind }} proposal-review-attachment inbox-attachment-link">
+          <span class="proposal-attachment__icon" aria-hidden="true">
+            <i data-lucide="{{ vm.content.inbox.attachment.icon }}" class="proposal-attachment__svg"></i>
+          </span>
