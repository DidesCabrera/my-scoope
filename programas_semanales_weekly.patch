+<div class="data-grid data-grid--list-panel data-grid--list-panel-delete js-list-delete-panel">
+    <h3 class="data-grid-list-panel-title">Eliminar Programas</h3>
+
+    {% for child in children %}
+        <div
+            class="data-grid-row data-grid-row--list-panel-delete js-list-delete-row"
+            data-item-id="{{ child.child_id }}"
+        >
+            <div class="data-grid-cell data-grid-cell--select">
+                <label class="list-panel-select" aria-label="Seleccionar programa">
+                    <input type="checkbox" class="js-list-delete-checkbox" value="{{ child.child_id }}">
+                    <span class="list-panel-select__control"></span>
+                </label>
+            </div>
+
+            <div class="data-grid-cell data-grid-cell--name">
+                <div class="list-panel-title-row">
+                    <i data-lucide="calendar-range" class="picker-summary-card__icon program list-panel-title-icon"></i>
+                    <div class="truncate">{{ child.title }}</div>
+                </div>
+            </div>
+
+            <div class="data-grid-cell data-grid-cell--action">
+                <form method="post" action="{% url 'program_remove' child.child_id %}">
+                    {% csrf_token %}
+                    <input type="hidden" name="return_to" value="{{ request.path }}?mode=delete">
+                    <button type="submit" aria-label="Eliminar programa">
+                        <i data-lucide="trash" class="table-icon"></i>
+                    </button>
+                </form>
+            </div>
+        </div>
+    {% empty %}
+        <div class="data-grid-empty">No tienes programas para eliminar.</div>
+    {% endfor %}
+</div>
