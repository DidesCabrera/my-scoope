+            ProgramDay.objects
+            .filter(program_id=program.id)
+            .order_by("date", "id")
+        )
+
+        if program.start_date and program.end_date:
+            duration_days = max((program.end_date - program.start_date).days + 1, 1)
+            duration_weeks = max((duration_days + 6) // 7, 1)
+        else:
+            duration_weeks = max((len(program_days) + 6) // 7, 1)
+
+        used_slots = set()
+
+        for index, program_day in enumerate(program_days):
+            if program_day.date and program.start_date:
+                offset = max((program_day.date - program.start_date).days, 0)
+                week_number = offset // 7 + 1
+                day_number = offset % 7 + 1
+            else:
+                week_number = index // 7 + 1
+                day_number = index % 7 + 1
+
+            while (week_number, day_number) in used_slots:
+                day_number += 1
+                if day_number > 7:
+                    week_number += 1
+                    day_number = 1
+
+            used_slots.add((week_number, day_number))
+            duration_weeks = max(duration_weeks, week_number)
+
+            program_day.week_number = week_number
+            program_day.day_number = day_number
+            program_day.save(update_fields=["week_number", "day_number"])
