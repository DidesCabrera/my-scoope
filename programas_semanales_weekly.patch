@@ -0,0 +1,76 @@
+<div class="card card--program program-card">
+  <div class="card-main program-card__main">
+    <div class="card-title program-card__title-block">
+      <div class="card-title-comp">
+        <div class="main-title">
+          <a href="{% url 'program_detail' child_card.child_id %}" class="card-title-link" aria-label="Ver detalle de {{ child_card.title }}">
+            <h3>{{ child_card.title }}</h3>
+          </a>
+
+          <div class="structural-indicators">
+            <span class="structural-item">
+              <span class="structural-value">{{ child_card.weeks_count }}</span>
+              <i data-lucide="calendar-range" class="card-icon main"></i>
+            </span>
+            <span class="structural-divider"></span>
+            <span class="structural-item">
+              <span class="structural-value">{{ child_card.filled_days_count }}/{{ child_card.duration_days }}</span>
+              <i data-lucide="clipboard-list" class="card-icon main"></i>
+            </span>
+          </div>
+        </div>
+
+        <div class="icons-title">
+          <i data-lucide="calendar-range" class="home-section-header-icon program"></i>
+          {% if child_card.is_shared %}
+            <div class="label-fork label-fork--shared" title="Compartido" aria-label="Compartido">
+              <i data-lucide="users" class="card-icon"></i>
+            </div>
+          {% endif %}
+        </div>
+      </div>
+    </div>
+
+    <div class="program-card__summary">
+      <div class="program-card__summary-item">
+        <span>Semanas</span>
+        <strong>{{ child_card.weeks_count }}</strong>
+      </div>
+      <div class="program-card__summary-item">
+        <span>Días asignados</span>
+        <strong>{{ child_card.filled_days_count }}/{{ child_card.duration_days }}</strong>
+      </div>
+      {% if child_card.primary_week %}
+        <div class="program-card__summary-item">
+          <span>Semana 1</span>
+          <strong>{{ child_card.primary_week.totals.total_kcal|floatformat:0 }} kcal</strong>
+        </div>
+      {% endif %}
+    </div>
+  </div>
+
+  <div class="program-week-strip" aria-label="Resumen semanal de {{ child_card.title }}">
+    {% for week in child_card.weeks %}
+      <div class="program-week-chip {% if week.filled_days_count == 0 %}is-empty{% endif %}">
+        <span>S{{ week.week_number }}</span>
+        <strong>{{ week.totals.total_kcal|floatformat:0 }}</strong>
+        <small>{{ week.filled_days_count }}/7 días</small>
+      </div>
+    {% endfor %}
+  </div>
+
+  <div class="card-bottom">
+    <div class="card-metadata">
+      <div class="metadata-comp">
+        <span class="metadata-item">
+          <strong>Creador</strong>
+          <span>{{ child_card.owner }}</span>
+        </span>
+      </div>
+    </div>
+
+    <div class="card-actions">
+      {% include "components/card_actions.html" with actions=child_card.actions %}
+    </div>
+  </div>
+</div>
