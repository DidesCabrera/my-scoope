+
+.program-slot-picker__option {
+  display: flex;
+  gap: 0.5rem;
+  align-items: flex-start;
+  padding: 0.5rem;
+  border-radius: 10px;
+  background: var(--surface-card-muted);
+  cursor: pointer;
