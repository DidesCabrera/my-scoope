 <!-- =============================== -->
 <!-- =============================== -->
 
-<body class="{% block body_class %}{% endblock %}">
+<body class="{% block body_class %}{% endblock %}{% if vm.ui.mode == 'list' %} page-header-meta-deferred{% endif %}">
     <div class="app">
 
 
@@ -273,6 +273,45 @@
                     clearAllSavedGroups();
                 });
             });
+
+    function setupHeaderMetaSentinel() {
+        const sentinel = document.querySelector(".js-header-meta-sentinel");
+        const body = document.body;
+
+        if (!sentinel || !body.classList.contains("page-header-meta-deferred")) {
+            return;
+        }
+
+        function setHeaderMetaVisibility(shouldShow) {
+            body.classList.toggle("page-header-meta-visible", shouldShow);
+        }
+
+        if ("IntersectionObserver" in window) {
+            const observer = new IntersectionObserver(
+                function (entries) {
+                    const entry = entries[0];
+                    setHeaderMetaVisibility(!entry.isIntersecting);
+                },
+                {
+                    root: null,
+                    threshold: 0,
+                    rootMargin: "-54px 0px 0px 0px",
+                }
+            );
+
+            observer.observe(sentinel);
+            return;
+        }
+
+        function handleScrollFallback() {
+            setHeaderMetaVisibility(window.scrollY > 80);
+        }
+
+        handleScrollFallback();
+        window.addEventListener("scroll", handleScrollFallback, { passive: true });
+    }
+
+    setupHeaderMetaSentinel();
         });
     </script>
 
