diff --git a/notas/static/notas/css/components/header.css b/notas/static/notas/css/components/header.css
--- a/notas/static/notas/css/components/header.css	2026-06-12 03:57:59.000000000 +0000
+++ b/notas/static/notas/css/components/header.css	2026-06-12 04:41:07.989481757 +0000
@@ -61,6 +61,44 @@
   display: block;
 }
 
+/* Deferred header metadata: shown after the page/list hero leaves the viewport */
+body.page-home .page-header .label-entity.header,
+body.page-home .page-header .header-title-mobile,
+body.page-header-meta-deferred .page-header .label-entity.header,
+body.page-header-meta-deferred .page-header .header-title-mobile {
+  display: flex;
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+  transform: translateY(-4px);
+  transition:
+    opacity 180ms ease,
+    transform 180ms ease,
+    visibility 180ms ease;
+}
+
+body.page-home.home-header-meta-visible .page-header .label-entity.header,
+body.page-home.home-header-meta-visible .page-header .header-title-mobile,
+body.page-header-meta-deferred.page-header-meta-visible .page-header .label-entity.header,
+body.page-header-meta-deferred.page-header-meta-visible .page-header .header-title-mobile {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transform: translateY(0);
+}
+
+@media (min-width: 981px) {
+  body.page-home .page-header .header-breadcrumbs,
+  body.page-header-meta-deferred .page-header .header-breadcrumbs {
+    display: none;
+  }
+
+  body.page-home .page-header .header-title-mobile,
+  body.page-header-meta-deferred .page-header .header-title-mobile {
+    margin-left: 8px;
+  }
+}
+
 .btn-list-header {
   height: 22px;
 }
