+  background: var(--nutrition-protein);
+}
+
+.dash-kpi-range__alloc-pill--carbs {
+  background: var(--nutrition-carbs);
+}
+
+.dash-kpi-range__alloc-pill--fat {
+  background: var(--nutrition-fat);
+}
+
+.dash-kpi-range--card .dash-kpi-range__row {
+  grid-template-columns: 58px minmax(74px, 88px) minmax(74px, 88px) minmax(82px, 1fr);
+}
+
+.dash-kpi-range--card .tot {
+  flex-basis: 88px;
+}
+
+.dash-kpi-range--card .tot h2 {
+  font-size: 1.65rem;
+}
+
+.dash-kpi-range--card .tot p {
+  font-size: 0.72rem;
