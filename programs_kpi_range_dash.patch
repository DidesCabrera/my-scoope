+<div class="dash-kpi-comp dash-kpi-range {{ modifier }}">
+
+  <!-- TOTAL CAL RANGE -->
+  <div class="tot dash-kpi-range__tot">
+    <p>Calories</p>
+    <h2>{{ ranges.tot_kcal.max }}</h2>
+    <p class="dash-kpi-range__min">{{ ranges.tot_kcal.min }}</p>
+  </div>
+
+  <!-- MACRO RANGES -->
+  <div class="macros dash-kpi-range__macros">
+
+    <!-- Protein -->
+    <div class="kpi-row dash-kpi-range__row">
+      <div class="kpi-label">Protein</div>
+
+      <div class="kpi-ppk dash-kpi-range__ppk">
+        <span class="proteins_per_kilo">{{ ranges.ppk.label }}</span>
+      </div>
+
+      <div class="kpi-grams dash-kpi-range__grams dash-kpi-range__grams--protein">
+        {{ ranges.protein.label }}
+      </div>
+
+      <div class="kpi-alloc dash-kpi-range__alloc">
+        <span class="dash-kpi-range__alloc-pill dash-kpi-range__alloc-pill--protein">
+          {{ ranges.alloc_protein.label }}
+        </span>
+      </div>
+    </div>
+
+    <!-- Carbs -->
+    <div class="kpi-row dash-kpi-range__row">
+      <div class="kpi-label">Carbs</div>
+
+      <div></div>
+
+      <div class="kpi-grams dash-kpi-range__grams dash-kpi-range__grams--carbs">
+        {{ ranges.carbs.label }}
+      </div>
+
+      <div class="kpi-alloc dash-kpi-range__alloc">
+        <span class="dash-kpi-range__alloc-pill dash-kpi-range__alloc-pill--carbs">
+          {{ ranges.alloc_carbs.label }}
+        </span>
+      </div>
+    </div>
+
+    <!-- Fat -->
+    <div class="kpi-row dash-kpi-range__row">
+      <div class="kpi-label">Fat</div>
+
+      <div></div>
+
+      <div class="kpi-grams dash-kpi-range__grams dash-kpi-range__grams--fat">
+        {{ ranges.fat.label }}
+      </div>
+
+      <div class="kpi-alloc dash-kpi-range__alloc">
+        <span class="dash-kpi-range__alloc-pill dash-kpi-range__alloc-pill--fat">
+          {{ ranges.alloc_fat.label }}
+        </span>
+      </div>
+    </div>
+
+  </div>
+</div>
