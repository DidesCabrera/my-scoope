+
+.dash-kpi-range--card .kpi-label,
+.dash-kpi-range--card .dash-kpi-range__grams,
+.dash-kpi-range--card .dash-kpi-range__ppk,
+.dash-kpi-range--card .dash-kpi-range__alloc-pill {
+  font-size: 0.78rem;
+}
+
+@media (max-width: 768px) {
+  .dash-kpi-range__row,
+  .dash-kpi-range--card .dash-kpi-range__row {
+    grid-template-columns: 56px minmax(70px, 84px) minmax(70px, 84px) minmax(78px, 1fr);
+  }
+
+  .dash-kpi-range--card .tot {
+    flex-basis: 82px;
+  }
+}
