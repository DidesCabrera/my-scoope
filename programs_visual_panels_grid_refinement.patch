--- a/notas/static/notas/css/components/programs.css
+++ b/notas/static/notas/css/components/programs.css
@@ -1085,3 +1085,271 @@
     font-size: 0.54rem;
   }
 }
+
+/* Program refinements ===================================== */
+.home-section-header-icon.program,
+.entity-form-header__icon.program,
+.main-modal-icon.program,
+.picker-summary-card__icon.program,
+.list-page-header__icon--program {
+  background: var(--entity-program);
+  color: #ffffff !important;
+  stroke: #ffffff !important;
+}
+
+.program-empty-state__icon,
+.program-hero__icon,
+.program-week-row__icon,
+.program-chart-panel__icon,
+.program-structural-icon {
+  background: var(--entity-program);
+  color: #ffffff !important;
+  stroke: #ffffff !important;
+  flex: 0 0 auto;
+}
+
+.program-empty-state__icon,
+.program-hero__icon {
+  padding: 8px;
+  border-radius: 12px;
+}
+
+.program-week-row__icon,
+.program-chart-panel__icon {
+  padding: 4px;
+  border-radius: 7px;
+}
+
+.program-card .structural-indicators .program-structural-icon,
+.program-board-header .structural-indicators .program-structural-icon {
+  width: 18px;
+  height: 18px;
+  padding: 3px;
+  border-radius: 5px;
+  background: var(--entity-program);
+  color: #ffffff !important;
+  stroke: #ffffff !important;
+}
+
+.program-day-cell {
+  align-content: stretch;
+  grid-template-rows: auto 1fr;
+  min-height: 92px;
+}
+
+.program-day-cell__day-initial {
+  justify-self: start;
+  color: var(--text-muted);
+  font-size: 0.68rem;
+  font-weight: 900;
+  line-height: 1;
+  text-transform: uppercase;
+}
+
+.program-day-cell__content {
+  align-self: center;
+}
+
+.program-day-cell__icon {
+  width: 30px;
+  height: 30px;
+  padding: 6px;
+  border-radius: 8px;
+  background: var(--entity-dailyplan);
+  color: #ffffff !important;
+  stroke: #ffffff !important;
+}
+
+.program-day-cell__tooltip-icon {
+  padding: 3px;
+  border-radius: 5px;
+  background: var(--entity-dailyplan);
+  color: #ffffff !important;
+  stroke: #ffffff !important;
+}
+
+.program-day-cell__menu {
+  display: none;
+}
+
+.program-day-cell__menu-toggle {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  border-radius: 9px;
+  background: var(--surface-card-muted);
+  color: var(--text-main);
+  cursor: pointer;
+  list-style: none;
+}
+
+.program-day-cell__menu-toggle::-webkit-details-marker {
+  display: none;
+}
+
+.program-day-cell__menu-list {
+  position: absolute;
+  z-index: 45;
+  top: calc(100% + 0.25rem);
+  right: 0;
+  display: grid;
+  gap: 0.2rem;
+  min-width: 144px;
+  padding: 0.35rem;
+  border: 1px solid var(--border-default);
+  border-radius: 10px;
+  background: var(--surface-elevated);
+  box-shadow: var(--shadow-elevated);
+}
+
+.program-day-cell__menu-item {
+  display: flex;
+  align-items: center;
+  gap: 0.45rem;
+  width: 100%;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text-main);
+  padding: 0.45rem 0.5rem;
+  font-size: 0.76rem;
+  font-weight: 800;
+  text-align: left;
+  cursor: pointer;
+}
+
+.program-day-cell__menu-item:hover {
+  background: var(--interactive-hover);
+}
+
+.program-day-cell__menu-item--danger {
+  color: #ff4d4d;
+}
+
+.program-card-panels {
+  overflow: hidden;
+}
+
+.program-card-panels__desktop {
+  display: block;
+}
+
+.data-grid-header--program-weeks,
+.data-grid-row--program-weeks {
+  grid-template-columns:
+    minmax(120px, 1.3fr)
+    minmax(72px, 0.8fr)
+    minmax(58px, 0.65fr)
+    minmax(58px, 0.65fr)
+    minmax(58px, 0.65fr)
+    minmax(86px, 0.9fr)
+    minmax(86px, 0.9fr)
+    minmax(86px, 0.9fr);
+}
+
+.data-grid-header--program-weeks-mobile,
+.data-grid-row--program-weeks-mobile {
+  grid-template-columns:
+    minmax(52px, 0.8fr)
+    minmax(64px, 0.8fr)
+    minmax(48px, 0.62fr)
+    minmax(48px, 0.62fr)
+    minmax(48px, 0.62fr);
+}
+
+.data-grid-header--program-weeks-mobile-alloc,
+.data-grid-row--program-weeks-mobile-alloc {
+  grid-template-columns:
+    minmax(52px, 0.75fr)
+    repeat(3, minmax(70px, 1fr));
+}
+
+.data-grid-cell--program-week,
+.data-grid-col--program-week {
+  justify-content: flex-start;
+  padding-inline: 4px;
+}
+
+.data-grid-cell--program-week {
+  font-weight: 650;
+}
+
+.program-week-table__macro--protein {
+  color: var(--nutrition-protein);
+  font-weight: 700;
+}
+
+.program-week-table__macro--carbs {
+  color: var(--nutrition-carbs);
+  font-weight: 700;
+}
+
+.program-week-table__macro--fat {
+  color: var(--nutrition-fat);
+  font-weight: 700;
+}
+
+.program-chart-plot--calories .program-chart-bar {
+  background: var(--kpi-total-border);
+}
+
+.program-chart-plot--ppk .program-chart-bar {
+  background: var(--nutrition-ppk);
+}
+
+.program-chart-stacked-bar__segment + .program-chart-stacked-bar__segment {
+  border-top: 1px solid color-mix(in srgb, var(--text-main) 34%, transparent);
+}
+
+@media (min-width: 981px) {
+  .program-card-panels .card-detail-tabs-mobile,
+  .program-card-panels .card-table-programs-mobile {
+    display: none !important;
+    opacity: 0 !important;
+  }
+
+  .program-card-panels__desktop {
+    display: block !important;
+  }
+}
+
+@media (max-width: 980px) {
+  .program-card-panels__desktop {
+    display: none !important;
+  }
+}
+
+@media (max-width: 780px) {
+  .program-day-cell {
+    min-height: 78px;
+    padding: 0.4rem 0.18rem;
+  }
+
+  .program-day-cell__icon {
+    width: 26px;
+    height: 26px;
+    padding: 5px;
+  }
+
+  .program-day-cell__actions--inline {
+    display: none;
+  }
+
+  .program-day-cell__menu {
+    position: absolute;
+    top: 0.25rem;
+    right: 0.25rem;
+    display: block;
+  }
+
+  .program-day-cell__actions {
+    opacity: 1;
+    pointer-events: auto;
+  }
+
+  .program-day-cell__tooltip {
+    display: none;
+  }
+}
