--- orig_myscoope/notas/static/notas/css/components/modal_create.css	2026-06-12 00:19:34.000000000 +0000
+++ work_myscoope/proyecto_django_export_ai/notas/static/notas/css/components/modal_create.css	2026-06-12 00:28:39.019750023 +0000
@@ -358,3 +358,140 @@
     width: auto;
   }
 }
+
+/* =========================================================
+   Shared create / rename entity form
+   ========================================================= */
+
+.page-modal--entity-form {
+  max-width: 720px;
+}
+
+.entity-form {
+  color: var(--text-main);
+}
+
+.entity-form__main-modal {
+  margin-bottom: 2px;
+}
+
+.entity-form__form {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+}
+
+.entity-form__section {
+  padding: 18px;
+  background: var(--surface-card-muted);
+  border: 0;
+  border-radius: 22px;
+  box-shadow: none;
+}
+
+.entity-form__section-header {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin-bottom: 16px;
+}
+
+.entity-form__section-header h3 {
+  margin: 0;
+  color: var(--text-main);
+  font-size: 1.05rem;
+  font-weight: 700;
+}
+
+.entity-form__field {
+  display: flex;
+  flex-direction: column;
+  gap: 7px;
+}
+
+.entity-form__label {
+  color: var(--text-main);
+  font-size: 0.92rem;
+  font-weight: 650;
+}
+
+.entity-form__label--hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+.entity-form__input {
+  width: 100%;
+  min-height: 46px;
+  padding: 10px 12px;
+  border: 1px solid var(--input-border);
+  border-radius: 12px;
+  background: var(--input-bg);
+  color: var(--input-text);
+  caret-color: var(--input-text);
+  font-size: 1rem;
+  transition:
+    border-color 140ms ease,
+    box-shadow 140ms ease,
+    background-color 140ms ease;
+}
+
+.entity-form__input:focus {
+  outline: none;
+  border-color: var(--input-focus-border);
+  box-shadow: 0 0 0 3px var(--input-focus-shadow);
+}
+
+.entity-form__input::placeholder {
+  color: var(--input-placeholder);
+}
+
+.entity-form__actions {
+  display: flex;
+  justify-content: flex-end;
+  align-items: center;
+  gap: 10px;
+  padding-top: 2px;
+}
+
+.entity-form__cancel,
+.entity-form__submit {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 38px;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.entity-form__submit {
+  font-weight: 650;
+}
+
+@media (max-width: 768px) {
+  .page-modal--entity-form {
+    max-width: none;
+  }
+
+  .entity-form__section {
+    padding: 16px;
+    border-radius: 18px;
+  }
+
+  .entity-form__actions {
+    justify-content: stretch;
+  }
+
+  .entity-form__cancel,
+  .entity-form__submit {
+    flex: 1 1 0;
+    width: auto;
+  }
+}
