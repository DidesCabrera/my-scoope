+        "protein",
+        "carbs",
+        "fat",
+        "kcal_protein",
+        "kcal_carbs",
+        "kcal_fat",
+    ):
+        averaged[key] = totals[key] / divisor
+    return _finalize_totals(averaged)
+
 def _kpi_from_totals(totals):
     return {
         "ppk": None,
@@ -407,11 +422,14 @@ def build_weekly_grid(program, program_days):
 
