  .program-chart-main-axis--program[data-weeks-count="12"] {
    --program-chart-day-margin: clamp(1px, 0.35vw, 2px);
    --program-chart-week-padding: clamp(0.08rem, 0.35vw, 0.18rem);
  }
}

/* Program week chart axis correction =========================================
   Week charts show 7 daily bars, so their X axis must use the day axis count,
   not the single-week count. Labels are initials in both desktop and mobile. */
.program-chart-main-axis--week .program-chart-week-axis {
  display: grid;
  grid-template-columns: repeat(var(--program-chart-axis-count, 7), minmax(0, 1fr));
  width: 100%;
  min-width: 100%;
  padding-inline: 0.35rem;
}

.program-chart-main-axis--week .program-chart-week-axis span {
  min-width: 0;
  padding-top: 0.22rem;
  overflow: hidden;
  text-align: center;
  text-overflow: clip;
  white-space: nowrap;
  border-left: 0;
  border-right: 0;
}

/* Program chart and card layout corrections =============================== */
.program-chart-bar,
.program-chart-stacked-bar {
  box-sizing: border-box;
  opacity: 1;
  border-style: solid;
  border-width: 2px 2px 0;
}

.program-chart-bar {
  border-color: color-mix(in srgb, var(--entity-program) 72%, #000 28%);
}

.program-chart-plot--calories .program-chart-bar {
  border-color: #764d35;
}

.program-chart-plot--protein .program-chart-bar {
  border-color: #00caff;
}

.program-chart-plot--carbs .program-chart-bar {
  border-color: #4fe888;
}

.program-chart-plot--fat .program-chart-bar {
  border-color: #bbff01;
}

.program-chart-plot--ppk .program-chart-bar {
  border-color: #ffd26b;
}

.program-chart-stacked-bar {
  border-color: color-mix(in srgb, var(--border-default) 78%, #000 22%);
}

@media (min-width: 981px) {
  .program-card__main {
    --program-card-title-width: clamp(180px, 28%, 320px);
    --program-card-kpi-width: 440px;
  }

  .program-card__title-block.card-title {
    flex: 0 1 var(--program-card-title-width);
    width: var(--program-card-title-width);
    max-width: var(--program-card-title-width);
  }

  .program-card__kpi-range {
    flex: 1 1 var(--program-card-kpi-width);
  }
}

/* Program charts: contiguous columns and stacked top contour =================
   Keep chart columns flush while the solid outline follows the total stacked
   bar silhouette instead of each internal macro segment. */
.program-chart-panel {
  --program-chart-bar-border-width: 2px;
  --program-chart-bar-radius: 0;
}

.program-chart-plot--program .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="5"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="6"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="7"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="8"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="9"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="10"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="11"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="12"] .program-chart-week-column {
  column-gap: 0;
  padding-inline: 0;
}

.program-chart-plot--program .program-chart-bar-slot,
.program-chart-plot--week .program-chart-bar-slot {
  padding-inline: 0;
}

.program-chart-bar,
.program-chart-stacked-bar,
.program-chart-panel--card .program-chart-bar,
.program-chart-panel--card .program-chart-stacked-bar,
.program-chart-panel--week .program-chart-bar,
.program-chart-panel--week .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-stacked-bar {
  width: 100%;
  max-width: none;
}

.program-chart-bar,
.program-chart-stacked-bar {
  box-sizing: border-box;
  opacity: 0.7;
  border-radius: 0;
}

.program-chart-bar {
  border-style: solid;
  border-width: var(--program-chart-bar-border-width) var(--program-chart-bar-border-width) 0;
}

.program-chart-stacked-bar {
  position: relative;
  border: 0;
  overflow: hidden;
}

.program-chart-stacked-bar::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 3;
  border-style: solid;
  border-width: var(--program-chart-bar-border-width) var(--program-chart-bar-border-width) 0;
  border-color: color-mix(in srgb, var(--border-default) 78%, #000 22%);
  border-radius: inherit;
  pointer-events: none;
}

.program-chart-stacked-bar__segment {
  border-radius: 0;
}

.program-chart-stacked-bar__segment.is-stack-top {
  border-radius: 0;
}


/* Program charts: skyline outline ==========================================
   Draw only the exposed vertical border of each contiguous column. The JS
   computes neighbor heights and stores the visible side length in CSS vars,
   so the outline follows the upper silhouette instead of framing every bar. */
.program-chart-bar,
.program-chart-stacked-bar {
  --program-chart-outline-color: color-mix(in srgb, var(--border-default) 78%, #000 22%);
  --program-chart-outline-left-height: 100%;
  --program-chart-outline-right-height: 100%;
}

.program-chart-bar {
  border: 0;
  background-image:
    linear-gradient(var(--program-chart-outline-color), var(--program-chart-outline-color)),
    linear-gradient(var(--program-chart-outline-color), var(--program-chart-outline-color)),
    linear-gradient(var(--program-chart-outline-color), var(--program-chart-outline-color));
  background-position: top left, top left, top right;
  background-repeat: no-repeat;
  background-size:
    100% var(--program-chart-bar-border-width),
    var(--program-chart-bar-border-width) var(--program-chart-outline-left-height),
    var(--program-chart-bar-border-width) var(--program-chart-outline-right-height);
}

.program-chart-stacked-bar::after {
  border: 0;
  background-image:
    linear-gradient(var(--program-chart-outline-color), var(--program-chart-outline-color)),
    linear-gradient(var(--program-chart-outline-color), var(--program-chart-outline-color)),
    linear-gradient(var(--program-chart-outline-color), var(--program-chart-outline-color));
  background-position: top left, top left, top right;
  background-repeat: no-repeat;
  background-size:
    100% var(--program-chart-bar-border-width),
    var(--program-chart-bar-border-width) var(--program-chart-outline-left-height),
    var(--program-chart-bar-border-width) var(--program-chart-outline-right-height);
}

/* Program charts: solid SVG silhouette outline =============================
   Draw the visible border as an overlay path instead of per-bar backgrounds.
   This keeps contiguous columns readable on mobile and lets the outline follow
   the real skyline of neighboring bars. */
.program-chart-panel {
  --program-chart-bar-border-width: 2px;
  --program-chart-outline-color: color-mix(in srgb, var(--border-default) 82%, #000 18%);
}

.program-chart-plot {
  position: relative;
}

.program-chart-main-axis--program {
  --program-chart-day-margin: 0px;
  --program-chart-week-padding: 0px;
}

.program-chart-main-axis--program[data-weeks-count="1"],
.program-chart-main-axis--program[data-weeks-count="2"],
.program-chart-main-axis--program[data-weeks-count="3"],
.program-chart-main-axis--program[data-weeks-count="4"],
.program-chart-main-axis--program[data-weeks-count="5"],
.program-chart-main-axis--program[data-weeks-count="6"],
.program-chart-main-axis--program[data-weeks-count="7"],
.program-chart-main-axis--program[data-weeks-count="8"],
.program-chart-main-axis--program[data-weeks-count="9"],
.program-chart-main-axis--program[data-weeks-count="10"],
.program-chart-main-axis--program[data-weeks-count="11"],
.program-chart-main-axis--program[data-weeks-count="12"] {
  --program-chart-day-margin: 0px;
  --program-chart-week-padding: 0px;
}

.program-chart-plot--program .program-chart-week-column,
.program-chart-main-axis--program .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="5"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="6"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="7"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="8"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="9"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="10"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="11"] .program-chart-week-column,
.program-chart-main-axis--program[data-weeks-count="12"] .program-chart-week-column {
  column-gap: 0;
  padding-inline: 0;
}

.program-chart-plot--program .program-chart-bar-slot,
.program-chart-plot--week .program-chart-bar-slot,
.program-chart-main-axis--program .program-chart-bar-slot {
  padding-inline: 0;
}

.program-chart-bar,
.program-chart-stacked-bar,
.program-chart-panel--card .program-chart-bar,
.program-chart-panel--card .program-chart-stacked-bar,
.program-chart-panel--week .program-chart-bar,
.program-chart-panel--week .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-stacked-bar {
  width: 100%;
  max-width: none;
}

.program-chart-bar,
.program-chart-stacked-bar {
  border: 0;
  background-image: none;
  outline: 0;
}

.program-chart-stacked-bar::after {
  display: none;
}

.program-chart-outline-svg {
  position: absolute;
  inset: 0;
  z-index: 8;
  width: 100%;
  height: 100%;
  overflow: visible;
  pointer-events: none;
}

.program-chart-outline-path {
  fill: none;
  stroke: var(--program-chart-outline-color);
  stroke-width: var(--program-chart-bar-border-width);
  stroke-linecap: butt;
  stroke-linejoin: miter;
  vector-effect: non-scaling-stroke;
}

.program-chart-outline-dot {
  fill: var(--program-chart-outline-color);
}

.program-chart-plot--calories {
  --program-chart-outline-color: #764d35;
}

.program-chart-plot--protein {
  --program-chart-outline-color: #00caff;
}

.program-chart-plot--carbs {
  --program-chart-outline-color: #4fe888;
}

.program-chart-plot--fat {
  --program-chart-outline-color: #bbff01;
}

.program-chart-plot--ppk {
  --program-chart-outline-color: #ffd26b;
}

.program-chart-plot--alloc,
.program-chart-plot--macros {
  --program-chart-outline-color: color-mix(in srgb, var(--border-default) 88%, #000 12%);
}

.program-chart-plot--program {
  padding-inline: 0;
}

.program-chart-bar,
.program-chart-stacked-bar,
.program-chart-stacked-bar__segment,
.program-chart-stacked-bar__segment.is-stack-top {
  border-radius: 0;
}

/* Program chart final alignment fixes ======================================
   Program plots must start and end flush for every week count. These overrides
   intentionally use the full selector because earlier geometry blocks set
   padding on .program-chart-main-axis--program .program-chart-plot, including
   mobile-specific rules. */
.program-chart-main-axis--program .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="5"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="6"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="7"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="8"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="9"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="10"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="11"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="12"] .program-chart-plot.program-chart-plot--program {
  padding-left: 0 !important;
  padding-right: 0 !important;
  padding-inline: 0 !important;
}

.program-chart-outline-svg {
  left: 0;
  top: 0;
  right: auto;
  bottom: auto;
  transform: translateZ(0);
}

@media (max-width: 780px) {
  .program-chart-main-axis--program .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="1"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="2"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="3"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="4"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="5"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="6"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="7"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="8"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="9"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="10"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="11"] .program-chart-plot.program-chart-plot--program,
  .program-chart-main-axis--program[data-weeks-count="12"] .program-chart-plot.program-chart-plot--program {
    padding-left: 0 !important;
    padding-bottom: 0 !important;
    padding-right: 0 !important;
    padding-inline: 0 !important;
  }
}

/* Program chart axis header and week separator alignment =====================
   The main axis now owns a small contextual header and the week divisions are
   drawn as background guides. This avoids border/z-index conflicts with the SVG
   silhouette while keeping the plot and labels aligned. */
.program-chart-main-axis {
  background: var(--surface-card);
  border-radius: 22px;
  padding: 0.75rem;
  gap: 0.55rem;
  overflow-x: auto;
  overflow-y: hidden;
}

.program-chart-axis-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  min-width: var(--program-chart-min-width, 100%);
  width: var(--program-chart-min-width, 100%);
  padding: 3px 4px 3px 8px;
}

.program-chart-axis-header__title {
  margin: 0;
  min-width: 0;
  color: var(--text-main);
  font-size: 22px;
  font-weight: 700;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.program-chart-axis-header__range {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 1.55rem;
  padding: 2px 12px;
  border-radius: 8px;
  background: var(--text-main);
  color: var(--text-inverted);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.01em;
  white-space: nowrap;
}

.program-chart-main-axis--program {
  --program-chart-week-separator-color: color-mix(in srgb, var(--border-default) 56%, transparent);
}

.program-chart-main-axis--program .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="5"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="6"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="7"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="8"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="9"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="10"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="11"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="12"] .program-chart-plot.program-chart-plot--program {
  padding-left: 0 !important;
  padding-right: 0 !important;
  padding-inline: 0 !important;
  background:
    linear-gradient(to top, color-mix(in srgb, var(--border-default) 42%, transparent) 1px, transparent 1px) 0 0 / 100% 25%,
    repeating-linear-gradient(
      to right,
      transparent 0,
      transparent calc((100% / var(--program-chart-weeks)) - 0.5px),
      var(--program-chart-week-separator-color) calc((100% / var(--program-chart-weeks)) - 0.5px),
      var(--program-chart-week-separator-color) calc((100% / var(--program-chart-weeks)) + 0.5px),
      transparent calc((100% / var(--program-chart-weeks)) + 0.5px),
      transparent calc(100% / var(--program-chart-weeks))
    ),
    var(--surface-card);
}

.program-chart-main-axis--program .program-chart-week-column,
.program-chart-main-axis--program .program-chart-week-column:first-of-type,
.program-chart-main-axis--program .program-chart-week-column:last-of-type,
.program-chart-main-axis--program .program-chart-week-axis span,
.program-chart-main-axis--program .program-chart-week-axis span:first-child,
.program-chart-main-axis--program .program-chart-week-axis span:last-child {
  border-left: 0 !important;
  border-right: 0 !important;
}

.program-chart-main-axis--program .program-chart-week-axis {
  padding-left: 0 !important;
  padding-right: 0 !important;
  padding-inline: 0 !important;
  overflow: hidden;
  background:
    repeating-linear-gradient(
      to right,
      transparent 0,
      transparent calc((100% / var(--program-chart-weeks)) - 0.5px),
      var(--program-chart-week-separator-color) calc((100% / var(--program-chart-weeks)) - 0.5px),
      var(--program-chart-week-separator-color) calc((100% / var(--program-chart-weeks)) + 0.5px),
      transparent calc((100% / var(--program-chart-weeks)) + 0.5px),
      transparent calc(100% / var(--program-chart-weeks))
    );
}

.program-chart-main-axis--program .program-chart-week-axis span {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding-top: 0.25rem;
  padding-bottom: 0.05rem;
}

.program-chart-main-axis--program .program-chart-guide {
  left: 0;
  right: 0;
  z-index: 0;
}

.program-chart-main-axis--program .program-chart-bar-slot {
  z-index: 2;
}

.program-chart-main-axis--program .program-chart-outline-svg {
  z-index: 4;
}

@media (max-width: 780px) {
  .program-chart-main-axis {
    padding: 12px 10px;
    border-radius: 20px;
    margin: 0 -6px;
  }

  .program-chart-axis-header {
    gap: 0.5rem;
    padding-left: 2px;
  }

  .program-chart-axis-header__title {
    font-size: 22px;
  }

  .program-chart-axis-header__range {
    min-height: 1.42rem;
    padding-inline: 0.48rem;
    font-size: 13px;
  }
}

/* Program chart: fixed contextual header and guide colors ================== */
.program-chart-axis-header {
  position: sticky;
  left: 0;
  z-index: 0;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  background: var(--surface-card);
}

.program-chart-axis-header__heading {
  display: inline-flex;
  align-items: baseline;
  min-width: 0;
  gap: 0.35rem;
}

.program-chart-axis-header__unit {
  flex: 0 0 auto;
  color: var(--text-main);
  font-size: 0.92em;
  font-style: italic;
  font-weight: 450;
  line-height: 1;
  white-space: nowrap;
}

.program-chart-guide {
  background: #d72d2d;
}

html[data-theme="dark"] .program-chart-guide {
  background: #ffffff;
}

@media (max-width: 780px) {
  .program-chart-axis-header {
    width: 100%;
    min-width: 0;
  }

  .program-chart-axis-header__heading {
    gap: 0.28rem;
  }
}

/* Program chart: muted min/max guides and weekly value units ================ */
.program-chart-guide {
  background: var(--text-muted);
}

.program-chart-guide--max,
.program-chart-guide--min {
  bottom: auto;
}

html[data-theme="dark"] .program-chart-guide {
  background: var(--text-muted);
}

.program-chart-panel--week .program-chart-bar-value {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.1rem;
  color: var(--text-main);
  line-height: 0.95;
  text-shadow: none;
}

.program-chart-panel--week .program-chart-bar-value__number,
.program-chart-panel--week .program-chart-bar-value__unit {
  display: block;
  color: var(--text-main);
  line-height: 1;
}

.program-chart-panel--week .program-chart-bar-value__unit {
  font-size: 0.68em;
  font-style: italic;
  font-weight: 450;
  letter-spacing: 0;
}

.program-chart-panel--week .program-chart-segment-value {
  color: var(--text-main);
  text-shadow: none;
}

/* Program chart: SVG max/min guides and bar hover tooltip =================== */
.program-chart-guide-svg {
  position: absolute;
  inset: 0;
  z-index: 5;
  width: 100%;
  height: 100%;
  overflow: visible;
  pointer-events: none;
}

.program-chart-guide-path {
  fill: none;
  stroke: #d72d2d;
  stroke-width: 2px;
  stroke-linecap: round;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
}

.program-chart-guide-dot {
  fill: #d72d2d;
  stroke: var(--surface-card);
  stroke-width: 1.5px;
  vector-effect: non-scaling-stroke;
}

.program-chart-outline-svg {
  z-index: 6;
}

.program-chart-bar-slot {
  overflow: visible;
}

.program-chart-bar-tooltip {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 10px);
  z-index: 20;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.24rem;
  min-width: 148px;
  max-width: min(220px, 74vw);
  padding: 0.55rem 0.65rem;
  border: 1px solid color-mix(in srgb, var(--border-default) 82%, transparent);
  border-radius: 14px;
  background: color-mix(in srgb, var(--surface-card) 94%, transparent);
  box-shadow: 0 16px 34px color-mix(in srgb, #000 24%, transparent);
  color: var(--text-main);
  opacity: 0;
  transform: translate(-50%, 4px);
  pointer-events: none;
  transition: opacity 0.14s ease, transform 0.14s ease;
}

.program-chart-bar-tooltip::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 100%;
  width: 10px;
  height: 10px;
  border-right: 1px solid color-mix(in srgb, var(--border-default) 82%, transparent);
  border-bottom: 1px solid color-mix(in srgb, var(--border-default) 82%, transparent);
  background: color-mix(in srgb, var(--surface-card) 94%, transparent);
  transform: translate(-50%, -5px) rotate(45deg);
}

.program-chart-bar-slot:hover .program-chart-bar-tooltip,
.program-chart-bar-slot:focus-within .program-chart-bar-tooltip {
  opacity: 1;
  transform: translate(-50%, 0);
}

.program-chart-bar-tooltip__header {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-width: 0;
}

.program-chart-bar-tooltip__icon {
  width: 16px;
  height: 16px;
  flex: 0 0 auto;
  color: var(--entity-program);
  stroke-width: 2.3;
}

.program-chart-bar-tooltip__name {
  min-width: 0;
  overflow: hidden;
  color: var(--text-main);
  font-size: 0.78rem;
  font-weight: 720;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.program-chart-bar-tooltip__value {
  color: var(--text-muted);
  font-size: 0.72rem;
  font-weight: 560;
  line-height: 1.1;
}

@media (max-width: 780px) {
  .program-add-week-form,
  .program-add-week-button.add-title {
    width: auto;
  }

  .program-add-week-button.add-title {
    flex: 0 0 auto;
    justify-content: center;
    margin-left: auto;
    padding-inline: 10px;
  }

  .program-add-week-button.add-title h4 {
    display: none;
  }

  .program-add-week-button .table-icon {
    width: 17px;
    height: 17px;
  }
}

/* Program chart: guide alignment, tooltip layering and add-week title row ===== */
.program-chart-guide-path {
  stroke: #d72d2d;
  stroke-width: 1px;
}

.program-chart-guide-dot {
  fill: #d72d2d;
  stroke: none;
  stroke-width: 0;
}

.program-chart-bar-slot:hover,
.program-chart-bar-slot:focus-within {
  z-index: 30;
}

.program-chart-bar-tooltip {
  z-index: 40;
  background: var(--surface-card);
  border-color: var(--border-default);
  color: var(--text-main);
  visibility: hidden;
}

.program-chart-bar-tooltip > * {
  position: relative;
  z-index: 1;
}

.program-chart-bar-tooltip::after {
  z-index: 0;
  background: var(--surface-card);
  border-color: var(--border-default);
}

.program-chart-bar-slot:hover .program-chart-bar-tooltip,
.program-chart-bar-slot:focus-within .program-chart-bar-tooltip {
  visibility: visible;
}

.program-weeks-title-section h3 {
  margin: 0;
  color: var(--text-main);
  white-space: nowrap;
}

@media (max-width: 780px) {
  .program-weeks-title-section {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .program-add-week-form,
  .program-add-week-button.add-title {
    width: auto;
  }

  .program-add-week-button.add-title {
    margin-left: auto;
  }
}

/* Program detail: chart tooltip, range badge and week plan section fixes ===== */
.program-chart-axis-header__range {
  background: var(--surface-card) !important;
  border: 1px solid #d72d2d !important;
  color: #d72d2d !important;
}

.program-chart-plot {
  overflow: visible;
  isolation: isolate;
}

.program-chart-guide-svg {
  z-index: 1;
}

.program-chart-outline-svg {
  z-index: 2;
}

.program-chart-bar-slot {
  z-index: 3;
}

.program-chart-bar-slot:hover,
.program-chart-bar-slot:focus-within {
  z-index: 60;
}

.program-chart-bar-tooltip {
  z-index: 80;
  background: var(--surface-card-muted);
  border-color: var(--border-soft);
  color: var(--text-main);
  opacity: 0;
  visibility: hidden;
}

.program-chart-bar-tooltip::after {
  background: var(--surface-card-muted);
  border-color: var(--border-soft);
}

.program-chart-bar-tooltip__header,
.program-chart-bar-tooltip__name,
.program-chart-bar-tooltip__value {
  color: var(--text-main);
}

.program-chart-bar-slot:hover .program-chart-bar-tooltip,
.program-chart-bar-slot:focus-within .program-chart-bar-tooltip {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
}

.program-chart-main-axis--program .program-chart-outline-svg,
.program-chart-main-axis--program .program-chart-guide-svg {
  pointer-events: none;
}

.program-week-child-card__header {
  --program-week-title-width: clamp(180px, 28%, 320px);
  --program-week-kpi-width: 440px;
  grid-template-columns: minmax(180px, var(--program-week-title-width)) minmax(var(--program-week-kpi-width), 1fr);
  align-items: flex-start;
}

.program-week-child-card__plan-section {
  display: grid;
  gap: 0.85rem;
  padding: 0.85rem;
  border-radius: 22px;
  background: var(--surface-card-muted);
}

.program-week-child-card__plan-section .program-week-child-card__days {
  margin: 0;
}

.program-day-selected-card {
  background: var(--surface-card);
  border-color: var(--border-soft);
}

.program-day-cell.has-plan.is-selected {
  background: color-mix(in srgb, var(--surface-card-muted) 72%, var(--surface-card) 28%);
  border-color: color-mix(in srgb, var(--border-soft) 68%, var(--text-main) 12%);
}

.program-day-selected-card__replace,
.program-day-selected-card__remove {
  flex: 0 0 auto;
}

@media (max-width: 980px) {
  .program-week-child-card__header {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 780px) {
  .program-week-child-card__plan-section {
    padding: 0.7rem;
    border-radius: 20px;
  }
}

/* Program detail corrections: day tooltip, default empty card and SVG grid ===== */
.program-day-cell.has-plan:focus-within .program-day-cell__tooltip {
  opacity: 0;
  transform: translate(-50%, 0.25rem);
}

.program-day-cell.has-plan:hover .program-day-cell__tooltip {
  opacity: 1;
  transform: translate(-50%, 0);
}

.program-day-empty-card {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  padding: 0.95rem 1rem;
  border: 1px solid var(--border-soft);
  border-radius: 18px;
  background: var(--surface-card);
  color: var(--text-main);
}

.program-day-empty-card[hidden] {
  display: none;
}

.program-day-empty-card__icon {
  width: 24px;
  height: 24px;
  flex: 0 0 auto;
  color: var(--entity-dailyplan);
}

.program-day-empty-card__body {
  display: grid;
  gap: 0.18rem;
  min-width: 0;
}

.program-day-empty-card__body strong {
  color: var(--text-main);
  font-size: 0.9rem;
  font-weight: 760;
  line-height: 1.15;
}

.program-day-empty-card__body span {
  color: var(--text-muted);
  font-size: 0.78rem;
  font-weight: 520;
  line-height: 1.25;
}

.program-chart-plot,
.program-chart-panel--week .program-chart-plot,
.program-chart-main-axis--program .program-chart-plot {
  background: var(--surface-card);
}

.program-chart-grid-svg {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  pointer-events: none;
}

.program-chart-grid-path {
  fill: none;
  stroke: color-mix(in srgb, var(--border-default) 42%, transparent);
  stroke-width: 1px;
  stroke-linecap: round;
  vector-effect: non-scaling-stroke;
}

.program-chart-guide-svg {
  z-index: 1;
}

.program-chart-outline-svg {
  z-index: 2;
}

.program-chart-bar-slot {
  z-index: 3;
}


/* Program detail corrections: chart scroll, SVG guide bounds and edit actions === */
.program-chart-main-axis {
  scrollbar-width: none;
}

.program-chart-main-axis::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.program-chart-main-axis--program[data-weeks-count="1"],
.program-chart-main-axis--program[data-weeks-count="2"],
.program-chart-main-axis--program[data-weeks-count="3"],
.program-chart-main-axis--program[data-weeks-count="4"] {
  overflow-x: hidden;
}

.program-chart-main-axis--program[data-weeks-count="5"],
.program-chart-main-axis--program[data-weeks-count="6"],
.program-chart-main-axis--program[data-weeks-count="7"],
.program-chart-main-axis--program[data-weeks-count="8"],
.program-chart-main-axis--program[data-weeks-count="9"],
.program-chart-main-axis--program[data-weeks-count="10"],
.program-chart-main-axis--program[data-weeks-count="11"],
.program-chart-main-axis--program[data-weeks-count="12"] {
  overflow-x: auto;
}

.program-chart-plot,
.program-chart-panel--week .program-chart-plot,
.program-chart-main-axis--program .program-chart-plot,
.program-chart-main-axis--program .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="4"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="5"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="6"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="7"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="8"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="9"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="10"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="11"] .program-chart-plot.program-chart-plot--program,
.program-chart-main-axis--program[data-weeks-count="12"] .program-chart-plot.program-chart-plot--program {
  background: var(--surface-card) !important;
}

.program-day-cell__add,
.program-day-cell__add-icon,
.program-day-cell.is-empty .program-day-cell__add-icon {
  color: #fff;
  stroke: #fff;
}

.program-day-selected-card .card-actions-row {
  width: 100%;
  justify-content: flex-start;
}

.program-day-selected-card .card-actions-row .program-day-selected-card__detail {
  margin-left: auto;
}

.data-grid-header--program-weeks-edit,
.data-grid-row--program-weeks-edit {
  grid-template-columns: 42px minmax(140px, 1fr) 44px 44px;
}

.data-grid--program-weeks-edit .data-grid-cell--action,
.data-grid--program-weeks-edit .data-grid-col--action {
  display: flex;
  align-items: center;
  justify-content: center;
}

@media (max-width: 780px) {
  .data-grid-header--program-weeks-edit,
  .data-grid-row--program-weeks-edit {
    grid-template-columns: 38px minmax(88px, 1fr) 40px 40px;
  }
}

/* Program detail corrections: mobile edit tab and chart tooltip hover ======= */
.program-chart-panel,
.program-chart-panel__body,
.program-chart-pane,
.program-chart-layout,
.program-chart-main-axis,
.program-chart-plot {
  overflow-y: visible;
}

.program-chart-bar-slot {
  --program-chart-tooltip-x: 50%;
}

.program-chart-bar-tooltip {
  left: var(--program-chart-tooltip-x, 50%) !important;
  z-index: 9999 !important;
  border: 1px solid var(--border-soft) !important;
  background: var(--surface-card-muted) !important;
  box-shadow: 0 18px 40px color-mix(in srgb, #000 34%, transparent);
}

.program-chart-bar-tooltip::after {
  left: 50%;
  border-right: 1px solid var(--border-soft) !important;
  border-bottom: 1px solid var(--border-soft) !important;
  background: var(--surface-card-muted) !important;
}

.program-chart-bar-slot:hover,
.program-chart-bar-slot:focus-within {
  z-index: 9998 !important;
}

.program-chart-bar-slot:hover .program-chart-bar,
.program-chart-bar-slot:focus-within .program-chart-bar,
.program-chart-bar-slot:hover .program-chart-stacked-bar,
.program-chart-bar-slot:focus-within .program-chart-stacked-bar {
  filter: brightness(1.22) saturate(1.08);
}

.program-chart-bar,
.program-chart-stacked-bar {
  transition: filter 0.14s ease;
}

.program-card-panels .card-table-programs-mobile .data-grid--program-weeks-edit {
  margin-top: 0;
}
