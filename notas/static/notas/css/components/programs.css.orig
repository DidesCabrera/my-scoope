    --program-chart-day-margin: 1.5px;
    --program-chart-day-space: 10px;
    --program-chart-week-content-width: 70px;
  }
}

/* Program chart geometry correction: fill available week width =================
   The program chart is daily, but weeks are the visual unit. For 1-4 weeks, each
   week uses an equal fraction of the available plot width. From week 5 onward,
   the same 4-week viewport rule applies through --program-chart-min-width.
   Margins are controlled per visible week count, while bar width derives from
   the actual day track so the grouped weeks occupy the available card width. */
.program-chart-main-axis--program {
  --program-chart-day-margin: 3px;
  --program-chart-week-padding: clamp(0.2rem, 0.8vw, 0.45rem);
}

.program-chart-main-axis--program[data-weeks-count="1"] {
  --program-chart-day-margin: clamp(7px, 1.3vw, 12px);
  --program-chart-week-padding: clamp(0.45rem, 1.6vw, 1.25rem);
}

.program-chart-main-axis--program[data-weeks-count="2"] {
  --program-chart-day-margin: clamp(5px, 0.9vw, 9px);
  --program-chart-week-padding: clamp(0.32rem, 1.1vw, 0.85rem);
}

.program-chart-main-axis--program[data-weeks-count="3"] {
  --program-chart-day-margin: clamp(3px, 0.65vw, 6px);
  --program-chart-week-padding: clamp(0.22rem, 0.75vw, 0.55rem);
}

.program-chart-main-axis--program[data-weeks-count="4"],
.program-chart-main-axis--program[data-weeks-count="5"],
.program-chart-main-axis--program[data-weeks-count="6"],
.program-chart-main-axis--program[data-weeks-count="7"],
.program-chart-main-axis--program[data-weeks-count="8"],
.program-chart-main-axis--program[data-weeks-count="9"],
.program-chart-main-axis--program[data-weeks-count="10"],
.program-chart-main-axis--program[data-weeks-count="11"],
.program-chart-main-axis--program[data-weeks-count="12"] {
  --program-chart-day-margin: clamp(2px, 0.45vw, 4px);
  --program-chart-week-padding: clamp(0.12rem, 0.45vw, 0.35rem);
}

.program-chart-main-axis--program .program-chart-plot {
  grid-template-columns: repeat(var(--program-chart-weeks), minmax(0, 1fr));
  column-gap: 0;
  background:
    linear-gradient(to top, color-mix(in srgb, var(--border-default) 42%, transparent) 1px, transparent 1px) 0 0 / 100% 25%,
    var(--surface-card);
}

.program-chart-main-axis--program .program-chart-week-column {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  column-gap: 0;
  justify-content: stretch;
  box-sizing: border-box;
  min-width: 0;
  padding-left: var(--program-chart-week-padding);
  padding-right: var(--program-chart-week-padding);
  border-left: 1px solid color-mix(in srgb, var(--border-default) 68%, transparent);
  border-right: 1px solid color-mix(in srgb, var(--border-default) 68%, transparent);
}

.program-chart-main-axis--program .program-chart-week-column:first-of-type {
  border-left: 0;
}

.program-chart-main-axis--program .program-chart-week-column:last-of-type {
  border-right: 0;
}

.program-chart-main-axis--program .program-chart-bar-slot {
  width: auto;
  min-width: 0;
  max-width: none;
  box-sizing: border-box;
  padding-left: var(--program-chart-day-margin);
  padding-right: var(--program-chart-day-margin);
}

.program-chart-main-axis--program .program-chart-bar,
.program-chart-main-axis--program .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="1"] .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-bar,
.program-chart-main-axis--program[data-weeks-count="2"] .program-chart-stacked-bar,
.program-chart-main-axis--program[data-weeks-count="3"] .program-chart-bar,
