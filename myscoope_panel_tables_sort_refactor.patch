+
+/* =========================================================
+   Temporary analysis sorting for panel tables
+   ========================================================= */
+
+.data-grid-col.is-grid-sortable {
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    min-width: 0;
+    cursor: pointer;
+    user-select: none;
+    transition:
+        color 0.15s ease,
+        opacity 0.15s ease;
+}
+
+.data-grid-col.is-grid-sortable:hover,
+.data-grid-col.is-grid-sortable:focus-visible {
+    color: var(--text-main);
+    opacity: 1;
+    outline: none;
+}
+
+.data-grid-col.is-grid-sortable::after {
+    content: "";
+    display: inline-flex;
+    width: 12px;
+    flex: 0 0 12px;
+    justify-content: center;
+    font-size: 11px;
+    line-height: 1;
+    color: currentColor;
+    opacity: 0;
+}
+
+.data-grid-col.is-grid-sorted::after {
+    opacity: 1;
+}
+
+.data-grid-col.is-grid-sorted-desc::after {
+    content: "▾";
+}
+
+.data-grid-col.is-grid-sorted-asc::after {
+    content: "▴";
+}
+
+.data-grid-col--name.is-grid-sortable,
+.data-grid-col--meal.is-grid-sortable,
+.data-grid-col--foods.is-grid-sortable {
+    justify-content: flex-start;
+}
+
+.data-grid-col--qty.is-grid-sortable,
+.data-grid-col--kcal.is-grid-sortable,
+.data-grid-col--macro.is-grid-sortable,
+.data-grid-col--alloc.is-grid-sortable,
+.data-grid-col--time.is-grid-sortable {
+    justify-content: center;
+}
