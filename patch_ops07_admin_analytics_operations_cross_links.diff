diff --git a/notas/static/notas/css/components/admin_analytics.css b/notas/static/notas/css/components/admin_analytics.css
index d1c8ba1..4a18b18 100644
--- a/notas/static/notas/css/components/admin_analytics.css
+++ b/notas/static/notas/css/components/admin_analytics.css
@@ -828,3 +828,73 @@ h3 {
     border-radius: 18px;
   }
 }
+
+/* =========================
+   OPS07 Admin Analytics → Operations bridge
+   ========================= */
+
+.admin-analytics-operations-bridge {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  border-style: dashed;
+  background:
+    radial-gradient(circle at 0% 0%, rgba(229, 229, 229, 0.08), transparent 34%),
+    var(--surface-card);
+}
+
+.admin-analytics-operations-bridge__main {
+  display: flex;
+  align-items: flex-start;
+  gap: 14px;
+  min-width: 0;
+}
+
+.admin-analytics-operations-bridge__icon {
+  display: inline-grid;
+  place-items: center;
+  flex: 0 0 auto;
+  width: 44px;
+  height: 44px;
+  border: 1px solid var(--border-soft);
+  border-radius: 16px;
+  background: var(--surface-card-strong);
+  color: var(--interactive-primary);
+}
+
+.admin-analytics-operations-bridge__icon svg,
+.admin-analytics-operations-bridge .btn-primary svg {
+  width: 18px;
+  height: 18px;
+}
+
+.admin-analytics-operations-bridge h3 {
+  margin-bottom: 6px;
+}
+
+.admin-analytics-operations-bridge .muted-text {
+  max-width: 820px;
+  margin-bottom: 0;
+}
+
+.admin-analytics-operations-bridge .btn-primary {
+  gap: 8px;
+  white-space: nowrap;
+}
+
+@media (max-width: 720px) {
+  .admin-analytics-operations-bridge {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .admin-analytics-operations-bridge__main {
+    flex-direction: column;
+  }
+
+  .admin-analytics-operations-bridge .detail-actions,
+  .admin-analytics-operations-bridge .btn-primary {
+    width: 100%;
+  }
+}
