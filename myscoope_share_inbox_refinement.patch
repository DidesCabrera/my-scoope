+}
+/* Sidebar unread notifications */
+.sidebar-notification-dot {
+    width: 8px;
+    height: 8px;
+    flex: 0 0 8px;
+    margin-left: auto;
+    border-radius: 999px;
+    background: var(--interactive-primary, #ffffff);
+    box-shadow: 0 0 0 3px color-mix(in srgb, var(--interactive-primary, #ffffff) 18%, transparent);
+}
+
+:where(body.sidebar-collapsed, html.sidebar-collapsed body) .sidebar-notification-dot {
+    position: absolute;
+    top: 5px;
+    right: 6px;
+    margin-left: 0;
+}
+
+:where(body.sidebar-collapsed, html.sidebar-collapsed body) .sidebar-left {
+    position: relative;
+}
