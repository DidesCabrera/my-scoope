+
+/* =========================================================
+   Share entity form
+   ========================================================= */
+
+.share-form__form {
+  gap: 14px;
+}
+
+.entity-form__textarea {
+  min-height: 116px;
+  resize: vertical;
+  line-height: 1.45;
+}
+
+.entity-form__error {
+  margin: 2px 0 0;
+  color: var(--color-danger, #ff5c5c);
+  font-size: 0.82rem;
+  font-weight: 650;
+}
+
+.share-form__attachment {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  width: fit-content;
+  max-width: 100%;
+  padding: 9px 12px;
+  border-radius: 999px;
+  background: var(--surface-card-muted);
+  color: var(--text-muted);
+  font-size: 0.86rem;
+  font-weight: 750;
+}
+
+.share-form__attachment span {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+@media (max-width: 768px) {
+  .share-form__attachment {
+    width: 100%;
+  }
+}
