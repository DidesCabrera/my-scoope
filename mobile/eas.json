{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "sandbox",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "sandbox",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://myscoope-staging.onrender.com",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production",
        "EXPO_PUBLIC_OAUTH_CLIENT_ID": "myscoope-ios",
        "EXPO_PUBLIC_OAUTH_REDIRECT_URI": "myscoope://oauth/callback",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6804048394"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6804048394"
      }
    }
  }
}
