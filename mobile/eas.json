{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "MYSCOOPE_BUILD_TARGET": "local",
        "EXPO_PUBLIC_DEPLOYMENT_ENV": "local",
        "EXPO_PUBLIC_API_BASE_URL": "http://127.0.0.1:8000",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "sandbox",
        "EXPO_PUBLIC_OAUTH_CLIENT_ID": "myscoope-ios",
        "EXPO_PUBLIC_OAUTH_REDIRECT_URI": "myscoope://oauth/callback",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "simulator-staging": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "MYSCOOPE_BUILD_TARGET": "staging",
        "EXPO_PUBLIC_DEPLOYMENT_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://myscoope-staging.onrender.com",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "sandbox",
        "EXPO_PUBLIC_OAUTH_CLIENT_ID": "myscoope-ios",
        "EXPO_PUBLIC_OAUTH_REDIRECT_URI": "myscoope://oauth/callback",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "MYSCOOPE_BUILD_TARGET": "staging",
        "EXPO_PUBLIC_DEPLOYMENT_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://myscoope-staging.onrender.com",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production",
        "EXPO_PUBLIC_OAUTH_CLIENT_ID": "myscoope-ios",
        "EXPO_PUBLIC_OAUTH_REDIRECT_URI": "myscoope://oauth/callback",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "android-alpha": {
      "autoIncrement": true,
      "environment": "preview",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "MYSCOOPE_BUILD_TARGET": "staging",
        "EXPO_PUBLIC_DEPLOYMENT_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://myscoope-staging.onrender.com",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production",
        "EXPO_PUBLIC_OAUTH_CLIENT_ID": "myscoope-ios",
        "EXPO_PUBLIC_OAUTH_REDIRECT_URI": "myscoope://oauth/callback",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "testflight-production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "MYSCOOPE_BUILD_TARGET": "production",
        "EXPO_PUBLIC_DEPLOYMENT_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://www.myscoope.com",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production",
        "EXPO_PUBLIC_OAUTH_CLIENT_ID": "myscoope-ios",
        "EXPO_PUBLIC_OAUTH_REDIRECT_URI": "myscoope://oauth/callback",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "extends": "testflight-production"
    }
  },
  "submit": {
    "testflight-production": {
      "ios": {
        "ascAppId": "6804048394"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6804048394"
      }
    }
  }
}
