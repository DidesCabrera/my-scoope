{
  "name": "@myscoope/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.19",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.11",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-iap": "^5.0.1",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run start:local",
    "start:local": "node ./scripts/mobile-environment-command.mjs development -- npx expo start --dev-client",
    "start:staging": "node ./scripts/mobile-environment-command.mjs simulator-staging -- npx expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:staging": "node ./scripts/mobile-environment-command.mjs simulator-staging -- npx expo run:ios",
    "build:production": "node ./scripts/mobile-environment-command.mjs testflight-production -- npx eas-cli@latest build --platform ios --profile testflight-production",
    "submit:production": "node ./scripts/mobile-environment-command.mjs testflight-production -- npx eas-cli@latest submit --platform ios --profile testflight-production",
    "verify:environments": "node ./scripts/mobile-environment-command.mjs --verify",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm --prefix .. run check:ui && npm run lint && npm run typecheck && npm test && npm run export:web",
    "export:web": "expo export --platform web"
  },
  "overrides": {
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "nanoid": "^3.3.18",
    "js-yaml": "4.3.2",
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "uuid": "^11.1.1"
  },
  "private": true
}
