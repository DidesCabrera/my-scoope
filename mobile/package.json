{
  "name": "@myscoope/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-community/datetimepicker": "8.1.1",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-iap": "^5.5.1",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run start:local",
    "start:local": "node ./scripts/mobile-environment-command.mjs development -- npx expo start --dev-client",
    "start:staging": "node ./scripts/mobile-environment-command.mjs simulator-staging -- npx expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:staging": "node ./scripts/mobile-environment-command.mjs simulator-staging -- npx expo run:ios",
    "build:production": "node ./scripts/mobile-environment-command.mjs testflight-production -- npx eas-cli@latest build --platform ios --profile testflight-production",
    "build:ios:staging": "node ./scripts/mobile-environment-command.mjs testflight-staging -- npx eas-cli@latest build --platform ios --profile testflight-staging",
    "build:android:alpha": "node ./scripts/mobile-environment-command.mjs android-alpha -- npx eas-cli@latest build --platform android --profile android-alpha",
    "submit:production": "node ./scripts/mobile-environment-command.mjs testflight-production -- npx eas-cli@latest submit --platform ios --profile testflight-production",
    "submit:ios:staging": "node ./scripts/mobile-environment-command.mjs testflight-staging -- npx eas-cli@latest submit --platform ios --profile testflight-staging",
    "verify:environments": "node ./scripts/mobile-environment-command.mjs --verify",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm --prefix .. run check:ui && npm run lint && npm run typecheck && npm test && npm run export:web",
    "export:web": "expo export --platform web"
  },
  "overrides": {
    "metro": {
      "image-size": "2.0.3"
    },
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "nanoid": "^3.3.18",
    "js-yaml": "4.3.2",
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "shell-quote": "1.11.0",
    "uuid": "^11.1.1"
  },
  "private": true
}
