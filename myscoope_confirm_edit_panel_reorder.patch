\ No newline at end of file
+}
+/* =========================================================
+   Edit panel order actions
+   ========================================================= */
+
+.data-grid-edit-actions {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    margin-top: 10px;
+    padding: 10px 0 2px;
+}
+
+.data-grid-edit-actions__status {
+    margin: 0;
+    font-size: 12px;
+    line-height: 1.35;
+    color: var(--text-muted);
+}
+
+.data-grid-edit-actions[data-state="dirty"] .data-grid-edit-actions__status {
+    color: var(--text-main);
+    font-weight: 500;
+}
+
+.data-grid-edit-actions__buttons {
+    display: inline-flex;
+    align-items: center;
+    justify-content: flex-end;
+    gap: 8px;
+    flex-shrink: 0;
+}
+
+.data-grid-edit-actions__button {
+    min-height: 28px;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    padding: 0 10px;
+    border-radius: 999px;
+    border: 1px solid var(--panel-tab-border);
+    font-size: 12px;
+    font-weight: 550;
+    cursor: pointer;
+    transition:
+        background-color 0.16s ease,
+        border-color 0.16s ease,
+        color 0.16s ease,
+        opacity 0.16s ease;
+}
+
+.data-grid-edit-actions__button--primary {
+    background: var(--panel-tab-active-bg);
+    border-color: var(--panel-tab-active-border);
+    color: var(--panel-tab-active-text);
+}
+
+.data-grid-edit-actions__button--secondary {
+    background: var(--panel-tab-bg);
+    border-color: var(--panel-tab-border);
+    color: var(--panel-tab-text);
+}
+
+.data-grid-edit-actions__button:not(:disabled):hover {
+    opacity: 0.82;
+}
+
+.data-grid-edit-actions__button:disabled {
+    cursor: default;
+    opacity: 0.42;
+}
+
+@media (max-width: 980px) {
+    .data-grid-edit-actions {
+        align-items: stretch;
+        flex-direction: column;
+        gap: 8px;
+        padding-top: 12px;
+    }
+
+    .data-grid-edit-actions__buttons {
+        width: 100%;
+    }
+
+    .data-grid-edit-actions__button {
+        flex: 1;
+        min-height: 32px;
+    }
+}
