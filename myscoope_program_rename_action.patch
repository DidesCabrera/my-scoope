+{% extends "notas/base.html" %}
+
+{% block title %}Renombrar Programa · {{ vm.content.program.name }}{% endblock %}
+
+{% block content %}
+<div class="page page--detail page-modal page-modal--entity-form">
+
+  <div class="wrap-page-modal entity-form">
+
+    <form method="post" class="entity-form__form" novalidate>
+      {% csrf_token %}
+
+      {% if vm.content.return_to %}
+        <input type="hidden" name="return_to" value="{{ vm.content.return_to }}">
+      {% endif %}
+
+      <div class="main-modal entity-form__main-modal">
+        <i data-lucide="calendar" class="main-modal-icon program"></i>
+        <h2 class="title-create">Renombra tu Programa Semanal</h2>
+      </div>
+
+      <section class="entity-form__section entity-form__section--name" aria-labelledby="program-rename-name-title">
+        <div class="entity-form__section-header">
+          <h3 id="program-rename-name-title">Elige un nuevo nombre</h3>
+        </div>
+
+        <div class="entity-form__field">
+          <label for="program-rename-name" class="entity-form__label entity-form__label--hidden">Nombre</label>
+          <input
+            id="program-rename-name"
+            type="text"
+            name="name"
+            value="{{ vm.content.program.name }}"
+            class="input-create entity-form__input"
+            autocomplete="off"
+            required
+          >
+        </div>
+      </section>
+
+      <div class="entity-form__actions">
+        {% if vm.content.return_to %}
+          <a href="{{ vm.content.return_to }}" class="btn-cancel-create entity-form__cancel">Cancelar</a>
+        {% else %}
+          <a href="{% url 'program_detail' vm.content.program.id %}" class="btn-cancel-create entity-form__cancel">Cancelar</a>
+        {% endif %}
+        <button type="submit" class="btn-continue entity-form__submit">Guardar</button>
+      </div>
+    </form>
+
+  </div>
+
+</div>
+{% endblock %}
