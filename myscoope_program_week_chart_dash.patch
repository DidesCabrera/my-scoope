diff -ruN a/notas/static/notas/css/components/programs.css b/notas/static/notas/css/components/programs.css
--- a/notas/static/notas/css/components/programs.css	2026-06-23 01:38:19.083026022 +0000
+++ b/notas/static/notas/css/components/programs.css	2026-06-23 01:38:19.127690178 +0000
@@ -2255,3 +2255,106 @@
     margin-top: 0;
   }
 }
+
+/* Weekly cards: title + dash KPI ================================== */
+.program-week-child-card__dash-kpi {
+  flex: 1 1 520px;
+  max-width: 640px;
+  min-width: 360px;
+  margin-left: auto;
+}
+
+.program-week-child-card__dash-kpi .dash-kpi-range--week-card {
+  width: 100%;
+}
+
+.dash-kpi-range--week-card .tot {
+  flex-basis: 84px;
+}
+
+.dash-kpi-range--week-card .tot h2 {
+  font-size: 1.48rem;
+}
+
+.dash-kpi-range--week-card .tot p {
+  font-size: 0.68rem;
+}
+
+.dash-kpi-range--week-card .dash-kpi-range__row {
+  grid-template-columns: 52px minmax(64px, 82px) minmax(64px, 82px) minmax(92px, 1fr);
+}
+
+.dash-kpi-range--week-card .kpi-label,
+.dash-kpi-range--week-card .dash-kpi-range__grams,
+.dash-kpi-range--week-card .dash-kpi-range__ppk,
+.dash-kpi-range--week-card .dash-kpi-range__alloc-bar .alloc-pct {
+  font-size: 0.68rem;
+}
+
+.dash-kpi-range--week-card .dash-kpi-range__alloc-bar {
+  grid-template-columns: 52px minmax(0, 1fr);
+}
+
+@media (max-width: 980px) {
+  .program-week-child-card__header {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .program-week-child-card__dash-kpi {
+    width: 100%;
+    max-width: none;
+    min-width: 0;
+    margin-left: 0;
+  }
+}
+
+/* Weekly chart values ================================== */
+.program-chart-bar,
+.program-chart-stacked-bar {
+  position: relative;
+  display: grid;
+  place-items: center;
+}
+
+.program-chart-stacked-bar {
+  display: flex;
+  flex-direction: column-reverse;
+}
+
+.program-chart-bar-value {
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  display: grid;
+  place-items: center;
+  padding: 0 2px;
+  color: var(--text-inverted);
+  font-size: 0.56rem;
+  font-weight: 850;
+  line-height: 1;
+  text-align: center;
+  text-shadow: 0 1px 2px color-mix(in srgb, #000 64%, transparent);
+  writing-mode: vertical-rl;
+  transform: rotate(180deg);
+  pointer-events: none;
+}
+
+.program-chart-panel--week .program-chart-bar,
+.program-chart-panel--week .program-chart-stacked-bar {
+  width: min(100%, 28px);
+}
+
+.program-chart-panel--week .program-chart-plot {
+  height: 166px;
+}
+
+.program-chart-panel--week .program-chart-bar-slot.is-empty .program-chart-bar-value {
+  display: none;
+}
+
+@media (min-width: 981px) {
+  .program-chart-panel--week .program-chart-bar-value {
+    font-size: 0.62rem;
+  }
+}
