     --program-chart-week-padding: clamp(0.08rem, 0.35vw, 0.18rem);
   }
 }
+
+/* Program week chart axis correction =========================================
+   Week charts show 7 daily bars, so their X axis must use the day axis count,
+   not the single-week count. Labels are initials in both desktop and mobile. */
+.program-chart-main-axis--week .program-chart-week-axis {
+  display: grid;
+  grid-template-columns: repeat(var(--program-chart-axis-count, 7), minmax(0, 1fr));
+  width: 100%;
+  min-width: 100%;
+  padding-inline: 0.35rem;
+}
+
+.program-chart-main-axis--week .program-chart-week-axis span {
+  min-width: 0;
+  padding-top: 0.22rem;
+  overflow: hidden;
+  text-align: center;
+  text-overflow: clip;
+  white-space: nowrap;
+  border-left: 0;
+  border-right: 0;
+}
