     min-height: calc(100svh + 64px);
   }
-}
\ No newline at end of file
+}
+/* =========================================================
+   List page header
+   ========================================================= */
+
+.list-page-header {
+    width: 100%;
+    margin: 0 0 18px 0;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: 12px;
+    text-align: center;
+}
+
+.list-page-header__icon {
+    width: 48px;
+    height: 48px;
+    flex-shrink: 0;
+    padding: 9px;
+    border-radius: 13px;
+    color: #ffffff;
+    stroke-width: 1.7;
+    background: var(--entity-home);
+}
+
+.list-page-header__icon--dailyplan {
+    background: var(--entity-dailyplan);
+}
+
+.list-page-header__icon--meal {
+    background: var(--entity-meal);
+}
+
+.list-page-header__icon--food {
+    background: var(--entity-food);
+}
+
+.list-page-header__icon--proposal {
+    background: var(--entity-proposal, var(--entity-home));
+}
+
+.list-page-header__title {
+    margin: 0;
+    color: var(--text-main);
+    font-size: 28px;
+    font-weight: 600;
+    line-height: 1.12;
+}
+
+@media (max-width: 768px) {
+    .list-page-header {
+        margin-bottom: 14px;
+        gap: 10px;
+    }
+
+    .list-page-header__icon {
+        width: 42px;
+        height: 42px;
+        padding: 8px;
+        border-radius: 12px;
+    }
+
+    .list-page-header__title {
+        font-size: 24px;
+    }
+}
