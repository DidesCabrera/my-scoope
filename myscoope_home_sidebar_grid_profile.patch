+
+/* Collapsed profile shortcut */
+.sidebar-profile-shortcut {
+    display: none;
+    align-items: center;
+    justify-content: center;
+    color: var(--sidebar-text-active);
+    text-decoration: none;
+}
+
+.sidebar-profile-shortcut-icon {
+    width: 30px;
+    height: 30px;
+    flex-shrink: 0;
+    padding: 6px;
+    border-radius: 9px;
+    color: var(--sidebar-text-active);
+    background-color: transparent;
+    stroke-width: 1.8;
+}
+
+.sidebar-profile-shortcut:hover .sidebar-profile-shortcut-icon,
+.sidebar-profile-shortcut.is-active .sidebar-profile-shortcut-icon {
+    background-color: rgba(255, 255, 255, 0.12);
+}
+
 /* Direct library groups */
