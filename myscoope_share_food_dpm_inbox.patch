@@ -0,0 +1,58 @@
+{% extends "notas/base.html" %}
+{% block title %}Compartir comida de plan{% endblock %}
+{% block content %}
+
+<div class="page page--detail page-modal page-modal--entity-form share-form-page share-form-page--dpm">
+  <div class="wrap-page-modal entity-form share-form">
+    <form method="post" action="{% url 'dailyplanmeal_share' dpm.dailyplan_id dpm.pk %}" class="entity-form__form share-form__form" novalidate>
+      {% csrf_token %}
+
+      <div class="main-modal entity-form__main-modal">
+        <i data-lucide="send" class="main-modal-icon meal"></i>
+        <h2 class="title-create">Compartir Comida de Plan</h2>
+      </div>
+
+      <section class="entity-form__section share-form__section" aria-labelledby="dpm-share-recipient-title">
+        <div class="entity-form__section-header"><h3 id="dpm-share-recipient-title">Destinatario</h3></div>
+        <div class="entity-form__field">
+          <label for="{{ form.recipient_email.id_for_label }}" class="entity-form__label">Email</label>
+          {{ form.recipient_email }}
+          {% if form.recipient_email.errors %}<p class="entity-form__error">{{ form.recipient_email.errors|striptags }}</p>{% endif %}
+        </div>
+      </section>
+
+      <section class="entity-form__section share-form__section" aria-labelledby="dpm-share-subject-title">
+        <div class="entity-form__section-header"><h3 id="dpm-share-subject-title">Asunto</h3></div>
+        <div class="entity-form__field">
+          <label for="{{ form.subject.id_for_label }}" class="entity-form__label entity-form__label--hidden">Asunto</label>
+          {{ form.subject }}
+          {% if form.subject.errors %}<p class="entity-form__error">{{ form.subject.errors|striptags }}</p>{% endif %}
+        </div>
+      </section>
+
+      <section class="entity-form__section share-form__section" aria-labelledby="dpm-share-message-title">
+        <div class="entity-form__section-header"><h3 id="dpm-share-message-title">Mensaje</h3></div>
+        <div class="entity-form__field">
+          <label for="{{ form.message.id_for_label }}" class="entity-form__label entity-form__label--hidden">Mensaje</label>
+          {{ form.message }}
+          {% if form.message.errors %}<p class="entity-form__error">{{ form.message.errors|striptags }}</p>{% endif %}
+        </div>
+      </section>
+
+      <div class="card-bottom proposal-list-card__bottom share-form__attachment" aria-label="Elemento a compartir">
+        <i data-lucide="paperclip" class="proposal-list-card__attachment-paperclip"></i>
