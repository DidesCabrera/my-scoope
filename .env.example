# My Scoope local environment contract. Never place real secrets in this file.
DJANGO_SETTINGS_MODULE=miapp.settings.dev
SECRET_KEY=
DATABASE_URL=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Accounts, onboarding and email
ACCOUNT_EMAIL_VERIFICATION=none
NUTRITION_ONBOARDING_GATE_ENABLED=true
RATE_LIMIT_LOGIN=10/m
RATE_LIMIT_SIGNUP=5/m
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=false
EMAIL_USE_TLS=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=My Scoope <no-reply@myscoope.com>
SERVER_EMAIL=My Scoope <no-reply@myscoope.com>

# AI Assistant: safe local defaults
AI_ASSISTANT_CHAT_ENGINE_MODE=deterministic
AI_ASSISTANT_LLM_PROVIDER=fake
AI_ASSISTANT_OPENAI_API_KEY=
AI_ASSISTANT_OPENAI_MODEL=gpt-5.4-mini
AI_ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
AI_ASSISTANT_OPENAI_TIMEOUT_SECONDS=30
AI_ASSISTANT_OPENAI_REASONING_EFFORT=low
AI_ASSISTANT_USAGE_OBSERVABILITY_ENABLED=true
AI_ASSISTANT_LLM_PRICING_USD_PER_1M_TOKENS_JSON=
AI_ASSISTANT_MAX_HISTORY_MESSAGES=8
AI_ASSISTANT_MAX_OUTPUT_TOKENS=900
AI_ASSISTANT_MAX_TOOL_LOOP_ITERATIONS=1
AI_ASSISTANT_MAX_INPUT_TOKENS=6000
AI_ASSISTANT_MAX_CONTEXT_CHARS=8000
AI_ASSISTANT_MAX_MESSAGE_CHARS=2000
AI_ASSISTANT_MAX_TOOL_REQUESTS_PER_TURN=3
AI_ASSISTANT_ENABLE_REVIEWABLE_PROPOSAL_TOOLS=false
AI_ASSISTANT_CREDITS_ENABLED=false
AI_ASSISTANT_USD_PER_AI_CREDIT=0.001
AI_ASSISTANT_DEFAULT_CREDITS_PER_TURN=1
AI_ASSISTANT_LLM_ROLLOUT_ENABLED=false
AI_ASSISTANT_LLM_ROLLOUT_MODE=off
AI_ASSISTANT_LLM_ROLLOUT_USER_IDS=
AI_ASSISTANT_LLM_ROLLOUT_PERCENT=0
AI_ASSISTANT_LLM_ROLLOUT_STICKY_SALT=
RATE_LIMIT_AI_ASSISTANT_TURN_USER=20/h
RATE_LIMIT_AI_ASSISTANT_TURN_IP=5/h

# Nutrition Solver
NUTRITION_SOLVER_BACKEND=heuristic_v2
NUTRITION_SOLVER_SHADOW_ENABLED=false
NUTRITION_SOLVER_SHADOW_BACKEND=cp_sat_v1
NUTRITION_SOLVER_TIME_LIMIT_MS=1500

# Observability and release identity
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
RENDER_GIT_COMMIT=
RENDER_SERVICE_NAME=

# Food Catalog external providers are disabled unless explicitly governed.
FOOD_CATALOG_FATSECRET_ENABLED=false
FOOD_CATALOG_FATSECRET_CLIENT_ID=
FOOD_CATALOG_FATSECRET_CLIENT_SECRET=
FOOD_CATALOG_FATSECRET_TOKEN_URL=https://oauth.fatsecret.com/connect/token
FOOD_CATALOG_FATSECRET_API_BASE_URL=https://platform.fatsecret.com/rest/server.api
FOOD_CATALOG_FATSECRET_OAUTH_SCOPE=basic
FOOD_CATALOG_FATSECRET_SEARCH_METHOD=foods.search
FOOD_CATALOG_FATSECRET_FOOD_GET_METHOD=food.get
FOOD_CATALOG_FATSECRET_TIMEOUT_SECONDS=15
FOOD_CATALOG_OPEN_FOOD_FACTS_ENABLED=false
FOOD_CATALOG_OPEN_FOOD_FACTS_API_BASE_URL=https://world.openfoodfacts.org
FOOD_CATALOG_OPEN_FOOD_FACTS_TIMEOUT_SECONDS=15
FOOD_CATALOG_OPEN_FOOD_FACTS_USER_AGENT=MyScoope FoodCatalog/1.0 (contact: support@myscoope.com)

# Calendarization notifications. Web Push remains disabled without VAPID credentials.
MYSCOOPE_WEB_PUSH_ENABLED=false
MYSCOOPE_VAPID_PUBLIC_KEY=
MYSCOOPE_VAPID_PRIVATE_KEY=
MYSCOOPE_VAPID_SUBJECT=mailto:notifications@myscoope.com
MYSCOOPE_PWA_CACHE_VERSION=v2

# Billing providers. Keep both integrations disabled until sandbox validation passes.
BILLING_MERCADOPAGO_WEBHOOK_ENABLED=false
BILLING_MERCADOPAGO_CHECKOUT_ENABLED=false
BILLING_PUBLIC_BASE_URL=
BILLING_MERCADOPAGO_ACCESS_TOKEN=
BILLING_MERCADOPAGO_WEBHOOK_SECRET=
BILLING_MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
BILLING_MERCADOPAGO_TIMEOUT_SECONDS=10
BILLING_MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_OPENFACTURA_ENABLED=false
BILLING_OPENFACTURA_API_KEY=
BILLING_OPENFACTURA_API_BASE_URL=https://dev-api.haulmer.com
BILLING_OPENFACTURA_TIMEOUT_SECONDS=10
BILLING_OPENFACTURA_ISSUER_JSON={}

# Production-only transport security. Production defaults remain secure.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
