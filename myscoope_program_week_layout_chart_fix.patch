--- a/notas/static/notas/css/components/programs.css
+++ b/notas/static/notas/css/components/programs.css
@@ -2358,3 +2358,69 @@
     font-size: 0.62rem;
   }
 }
+
+
+/* Program week card refinements ================================== */
+.program-week-child-card__header {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
+  align-items: start;
+  gap: 0.85rem;
+}
+
+.program-week-child-card__title-comp {
+  width: auto;
+  min-width: 0;
+}
+
+.program-week-child-card__dash-kpi {
+  width: 100%;
+  max-width: none;
+  min-width: 0;
+  margin-left: 0;
+}
+
+.program-chart-panel--week .program-chart-bar,
+.program-chart-panel--week .program-chart-stacked-bar {
+  width: 80%;
+  max-width: none;
+}
+
+.program-chart-panel--week .program-chart-bar-value {
+  writing-mode: horizontal-tb;
+  transform: none;
+  white-space: nowrap;
+  font-size: 0.56rem;
+  letter-spacing: -0.02em;
+}
+
+.program-chart-panel--week .program-chart-week-axis {
+  grid-template-columns: repeat(var(--program-chart-weeks), minmax(0, 1fr));
+  color: var(--text-muted);
+  font-size: 0.62rem;
+  font-weight: 850;
+  text-transform: none;
+}
+
+.program-chart-panel--week .program-chart-week-axis span {
+  overflow: hidden;
+  padding-top: 0.22rem;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+@media (max-width: 980px) {
+  .program-week-child-card__header {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 780px) {
+  .program-chart-panel--week .program-chart-bar-value {
+    font-size: 0.5rem;
+  }
+
+  .program-chart-panel--week .program-chart-week-axis {
+    font-size: 0.54rem;
+  }
+}
