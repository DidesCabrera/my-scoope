+
+/* Program metric chart ================================== */
+.program-chart-panel {
+  display: grid;
+  gap: 0.85rem;
+  padding: 0.9rem;
+  border: 1px solid var(--border-default);
+  border-radius: 18px;
+  background: var(--surface-card);
+  overflow: hidden;
+}
+
+.program-chart-panel--detail {
+  margin-bottom: 1rem;
+}
+
+.program-chart-panel--card {
+  margin: 0.85rem 0 1rem;
+}
+
+.program-chart-panel__header {
+  display: flex;
+  justify-content: space-between;
+  gap: 0.75rem;
+  align-items: flex-start;
+}
+
+.program-chart-panel__header h3,
+.program-chart-panel__eyebrow {
+  margin: 0;
+}
+
+.program-chart-panel__header h3 {
+  font-size: 1rem;
+  line-height: 1.15;
+}
+
+.program-chart-panel__header span,
+.program-chart-panel__eyebrow,
+.program-chart-bar-value,
+.program-chart-bar-day {
+  color: var(--text-muted);
+}
+
+.program-chart-panel__eyebrow {
+  margin-bottom: 0.2rem;
+  color: var(--entity-program);
+  font-size: 0.68rem;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.program-chart-panel__header span {
+  display: inline-block;
+  margin-top: 0.18rem;
+  font-size: 0.76rem;
+}
+
+.program-chart-panel__icon {
+  width: 24px;
+  height: 24px;
+  color: var(--entity-program);
+  flex: 0 0 auto;
+}
+
+.program-chart-tabs {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.35rem;
+}
+
+.program-chart-tab {
+  border: 1px solid var(--border-default);
+  border-radius: 999px;
+  background: var(--surface-card-muted);
+  color: var(--text-muted);
+  padding: 0.38rem 0.6rem;
+  font-size: 0.72rem;
+  font-weight: 800;
+  cursor: pointer;
+}
+
+.program-chart-tab.is-active {
+  border-color: color-mix(in srgb, var(--entity-program) 42%, var(--border-default));
+  background: color-mix(in srgb, var(--entity-program) 14%, var(--surface-card-muted));
+  color: var(--text-main);
+}
+
+.program-chart-panel__body,
+.program-chart-pane {
+  min-width: 0;
+}
+
+.program-chart-pane[hidden] {
+  display: none;
+}
+
+.program-chart-plot {
+  --program-chart-days: 7;
+  display: grid;
+  grid-template-columns: repeat(var(--program-chart-days), minmax(3px, 1fr));
+  align-items: end;
+  gap: 0;
+  min-width: 0;
+  height: 156px;
+  padding: 0.65rem 0.2rem 0.2rem;
+  border: 1px solid color-mix(in srgb, var(--entity-program) 12%, var(--border-default));
+  border-radius: 14px;
+  background:
+    linear-gradient(to top, color-mix(in srgb, var(--border-default) 48%, transparent) 1px, transparent 1px) 0 0 / 100% 25%,
+    color-mix(in srgb, var(--surface-card-muted) 72%, transparent);
+}
+
+.program-chart-bar-slot {
+  position: relative;
+  display: grid;
+  align-items: end;
+  justify-items: center;
+  gap: 0.2rem;
+  height: 100%;
+  min-width: 0;
+  padding: 0 0.12rem;
+}
+
+.program-chart-bar-slot.is-week-start {
+  border-left: 2px solid color-mix(in srgb, var(--entity-program) 48%, var(--border-default));
+}
+
+.program-chart-bar-slot.is-empty {
+  opacity: 0.48;
+}
+
+.program-chart-bar,
+.program-chart-stacked-bar {
+  width: min(100%, 18px);
+  min-height: 2px;
+  border-radius: 8px 8px 2px 2px;
+  overflow: hidden;
+}
+
+.program-chart-bar {
+  background: linear-gradient(
+    to top,
+    color-mix(in srgb, var(--entity-program) 68%, var(--surface-card)),
+    color-mix(in srgb, var(--entity-program) 34%, var(--surface-card))
+  );
+}
+
+.program-chart-stacked-bar {
+  display: flex;
+  flex-direction: column-reverse;
+  background: var(--surface-card);
+  border: 1px solid color-mix(in srgb, var(--border-default) 72%, transparent);
+}
+
+.program-chart-stacked-bar__segment {
+  display: block;
+  width: 100%;
+  min-height: 0;
+}
+
+.program-chart-stacked-bar__segment--protein,
+.program-chart-legend__swatch--protein {
+  background: var(--entity-dailyplan);
+}
+
+.program-chart-stacked-bar__segment--carbs,
+.program-chart-legend__swatch--carbs {
+  background: var(--entity-meal);
+}
+
+.program-chart-stacked-bar__segment--fat,
+.program-chart-legend__swatch--fat {
+  background: var(--entity-food);
+}
+
+.program-chart-bar-value {
+  max-width: 100%;
+  min-height: 1.05rem;
+  font-size: 0.58rem;
+  font-weight: 800;
+  line-height: 1;
+  overflow: hidden;
+  text-align: center;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.program-chart-bar-day {
+  min-height: 0.85rem;
+  font-size: 0.52rem;
+  font-weight: 800;
+  line-height: 1;
+}
+
+.program-chart-legend {
+  display: flex;
+  justify-content: flex-end;
+  gap: 0.75rem;
+  margin-top: 0.5rem;
+  color: var(--text-muted);
+  font-size: 0.68rem;
+  font-weight: 800;
+}
+
+.program-chart-legend span {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.25rem;
+}
+
+.program-chart-legend__swatch {
+  width: 0.6rem;
+  height: 0.6rem;
+  border-radius: 999px;
+}
+
+.program-chart-panel--card {
+  padding: 0.75rem;
+}
+
+.program-chart-panel--card .program-chart-panel__header span,
+.program-chart-panel--card .program-chart-bar-value,
+.program-chart-panel--card .program-chart-bar-day {
+  display: none;
+}
+
+.program-chart-panel--card .program-chart-panel__header h3 {
+  font-size: 0.88rem;
+}
+
+.program-chart-panel--card .program-chart-tabs {
+  gap: 0.25rem;
+}
+
+.program-chart-panel--card .program-chart-tab {
+  padding: 0.3rem 0.45rem;
+  font-size: 0.64rem;
+}
+
+.program-chart-panel--card .program-chart-plot {
+  height: 92px;
+  padding-top: 0.4rem;
+}
+
+.program-chart-panel--card .program-chart-bar,
+.program-chart-panel--card .program-chart-stacked-bar {
+  width: min(100%, 12px);
+}
+
+@media (max-width: 780px) {
+  .program-chart-panel {
+    padding: 0.75rem;
+  }
+
+  .program-chart-panel__header {
+    align-items: flex-start;
+  }
+
+  .program-chart-plot {
+    height: 118px;
+    padding-inline: 0.12rem;
+  }
+
+  .program-chart-bar,
+  .program-chart-stacked-bar {
+    width: min(100%, 10px);
+  }
+
+  .program-chart-bar-value {
+    display: none;
+  }
+
+  .program-chart-bar-day {
+    font-size: 0.48rem;
+  }
+}
diff -ruN myscoope97_orig/notas/static/notas/js/program_metric_chart.js myscoope97_mod/notas/static/notas/js/program_metric_chart.js
--- myscoope97_orig/notas/static/notas/js/program_metric_chart.js	1970-01-01 00:00:00.000000000 +0000
+++ myscoope97_mod/notas/static/notas/js/program_metric_chart.js	2026-06-19 03:13:46.821386181 +0000
@@ -0,0 +1,22 @@
+document.addEventListener("DOMContentLoaded", () => {
+  document.querySelectorAll(".js-program-chart").forEach((chart) => {
+    const tabs = Array.from(chart.querySelectorAll(".js-program-chart-tab"));
+    const panes = Array.from(chart.querySelectorAll(".js-program-chart-pane"));
+
+    function activate(metricKey) {
+      tabs.forEach((tab) => {
+        const isActive = tab.dataset.metric === metricKey;
+        tab.classList.toggle("is-active", isActive);
+        tab.setAttribute("aria-selected", isActive ? "true" : "false");
+      });
+
+      panes.forEach((pane) => {
+        pane.hidden = pane.dataset.metric !== metricKey;
+      });
+    }
+
+    tabs.forEach((tab) => {
+      tab.addEventListener("click", () => activate(tab.dataset.metric));
+    });
+  });
+});
