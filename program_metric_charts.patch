diff -ruN myscoope97_orig/notas/templates/components/program_metric_chart.html myscoope97_mod/notas/templates/components/program_metric_chart.html
--- myscoope97_orig/notas/templates/components/program_metric_chart.html	1970-01-01 00:00:00.000000000 +0000
+++ myscoope97_mod/notas/templates/components/program_metric_chart.html	2026-06-19 03:13:25.345132763 +0000
@@ -0,0 +1,76 @@
+{% if chart and chart.metrics %}
+<section class="program-chart-panel {{ modifier }} js-program-chart" aria-label="{{ chart.title }}">
+  <header class="program-chart-panel__header">
+    <div>
+      <p class="program-chart-panel__eyebrow">Gráfico diario</p>
+      <h3>{{ chart.title }}</h3>
+      <span>{{ chart.subtitle }}</span>
+    </div>
+    <i data-lucide="bar-chart-3" class="program-chart-panel__icon"></i>
+  </header>
+
+  <div class="program-chart-tabs" role="tablist" aria-label="Variable del gráfico">
+    {% for metric in chart.metrics %}
+      <button
+        type="button"
+        class="program-chart-tab js-program-chart-tab {% if metric.is_active %}is-active{% endif %}"
+        data-metric="{{ metric.key }}"
+        role="tab"
+        aria-selected="{% if metric.is_active %}true{% else %}false{% endif %}"
+      >
+        {{ metric.label }}
+      </button>
+    {% endfor %}
+  </div>
+
+  <div class="program-chart-panel__body">
+    {% for metric in chart.metrics %}
+      <div
+        class="program-chart-pane js-program-chart-pane"
+        data-metric="{{ metric.key }}"
+        {% if not metric.is_active %}hidden{% endif %}
+      >
+        <div
+          class="program-chart-plot program-chart-plot--{{ metric.kind }}"
+          style="--program-chart-days: {{ chart.days_count|default:1 }};"
+          aria-label="Gráfico de {{ metric.label }}"
+        >
+          {% for bar in metric.bars %}
+            <div
+              class="program-chart-bar-slot {% if bar.is_week_start %}is-week-start{% endif %} {% if bar.is_empty %}is-empty{% endif %}"
+              title="{{ bar.title }}"
+              aria-label="{{ bar.title }}"
+            >
+              <span class="program-chart-bar-value">{{ bar.value_label }}</span>
+
+              {% if metric.kind == "stacked" %}
+                <div class="program-chart-stacked-bar" style="height: {{ bar.height_percent|floatformat:2 }}%;">
+                  {% for segment in bar.segments %}
+                    <span
+                      class="program-chart-stacked-bar__segment program-chart-stacked-bar__segment--{{ segment.key }}"
+                      style="height: {{ segment.height_percent|floatformat:2 }}%;"
+                      aria-label="{{ segment.label }} {{ segment.height_percent|floatformat:0 }}%"
+                    ></span>
+                  {% endfor %}
+                </div>
+              {% else %}
+                <div class="program-chart-bar" style="height: {{ bar.height_percent|floatformat:2 }}%;"></div>
+              {% endif %}
+
+              <span class="program-chart-bar-day">{{ bar.x_label }}</span>
+            </div>
+          {% endfor %}
+        </div>
+
+        {% if metric.kind == "stacked" %}
+          <div class="program-chart-legend" aria-label="Leyenda de alloc">
+            <span><i class="program-chart-legend__swatch program-chart-legend__swatch--protein"></i>P%</span>
+            <span><i class="program-chart-legend__swatch program-chart-legend__swatch--carbs"></i>C%</span>
+            <span><i class="program-chart-legend__swatch program-chart-legend__swatch--fat"></i>F%</span>
+          </div>
+        {% endif %}
+      </div>
+    {% endfor %}
+  </div>
+</section>
+{% endif %}
