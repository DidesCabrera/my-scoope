diff --git a/notas/static/notas/css/components/dash_kpi.css b/notas/static/notas/css/components/dash_kpi.css
index 5f85c74..595841b 100644
--- a/notas/static/notas/css/components/dash_kpi.css
+++ b/notas/static/notas/css/components/dash_kpi.css
@@ -314,3 +314,46 @@ padding: 0 4px;
     flex-basis: 82px;
   }
 }
+
+/* Program KPI range alloc bars ========================= */
+.dash-kpi-range__alloc-bar {
+  display: grid;
+  grid-template-columns: 62px minmax(0, 1fr);
+  align-items: stretch;
+  width: 100%;
+  min-width: 0;
+  height: 24px;
+}
+
+.dash-kpi-range__alloc-bar .alloc-pct {
+  width: auto;
+  min-width: 0;
+  padding: 0 4px;
+  font-size: 0.76rem;
+  font-weight: 620;
+  font-variant-numeric: tabular-nums;
+}
+
+.dash-kpi-range__alloc-bar .alloc-pct p {
+  margin: 0;
+  line-height: 1;
+}
+
+.dash-kpi-range__alloc-bar .alloc-bar-comp {
+  height: 24px;
+}
+
+.dash-kpi-range--card .dash-kpi-range__alloc-bar {
+  grid-template-columns: 58px minmax(0, 1fr);
+}
+
+.dash-kpi-range--card .dash-kpi-range__alloc-bar .alloc-pct {
+  font-size: 0.68rem;
+}
+
+@media (max-width: 768px) {
+  .dash-kpi-range__alloc-bar,
+  .dash-kpi-range--card .dash-kpi-range__alloc-bar {
+    grid-template-columns: 58px minmax(0, 1fr);
+  }
+}
diff --git a/notas/static/notas/css/components/programs.css b/notas/static/notas/css/components/programs.css
