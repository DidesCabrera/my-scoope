+}
+
+.proposal-review-empty {
+  margin: 0;
+  padding: 14px;
+  color: var(--text-muted);
+  font-size: 0.9rem;
+}
+
+/* =========================================================
+   Review actions
+   ========================================================= */
+
+.proposal-review-actions,
+.proposal-review-apply,
+.proposal-review-applied {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 16px;
+  border: 1px solid var(--border-soft);
+  border-radius: 22px;
+  background: var(--surface-card);
+  color: var(--text-main);
+}
+
+.proposal-review-apply {
+  border-color: color-mix(in srgb, var(--interactive-primary) 20%, var(--border-soft));
+  background: color-mix(in srgb, var(--interactive-primary) 6%, var(--surface-card));
+}
+
+.proposal-review-applied {
+  border-color: rgba(34, 197, 94, 0.18);
+  background: color-mix(in srgb, rgb(34, 197, 94) 7%, var(--surface-card));
+}
+
+.proposal-review-actions-copy {
+  display: grid;
+  gap: 4px;
+}
+
+.proposal-review-actions-text {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: 0.92rem;
+  line-height: 1.45;
+}
+
+.proposal-review-actions-text strong {
+  color: var(--text-main);
+}
+
+.proposal-review-actions-buttons {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+  gap: 8px;
+}
+
+.proposal-review-action,
+.proposal-review-result-link {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 38px;
+  border: 1px solid transparent;
+  border-radius: 999px;
+  padding: 0 14px;
+  cursor: pointer;
+  font: inherit;
+  font-size: 0.84rem;
+  font-weight: 800;
+  line-height: 1;
+  text-decoration: none;
+  transition:
+    opacity 0.15s ease,
+    transform 0.12s ease,
+    background-color 0.15s ease,
+    border-color 0.15s ease;
+}
+
+.proposal-review-action:hover,
+.proposal-review-result-link:hover {
+  opacity: 0.78;
+  text-decoration: none;
+}
+
+.proposal-review-action:active,
+.proposal-review-result-link:active {
+  transform: translateY(1px);
+}
+
+.proposal-review-action--approve,
+.proposal-review-result-link {
+  background: rgba(34, 197, 94, 0.14);
+  color: rgb(21, 128, 61);
+}
+
+.proposal-review-action--reject {
+  background: rgba(239, 68, 68, 0.12);
+  color: rgb(185, 28, 28);
+}
+
+.proposal-review-action--cancel {
+  background: var(--surface-card-muted);
+  border-color: var(--border-soft);
+  color: var(--text-muted);
+}
+
+.proposal-review-action--apply {
+  background: var(--interactive-primary);
+  color: var(--text-inverted);
+}
+
+.proposal-review-actions--final {
+  justify-content: flex-start;
+}
+
+html[data-theme="dark"] .proposal-review-action--approve,
+html[data-theme="dark"] .proposal-review-result-link {
+  color: rgb(134, 239, 172);
+}
+
+html[data-theme="dark"] .proposal-review-action--reject {
+  color: rgb(252, 165, 165);
+}
+
