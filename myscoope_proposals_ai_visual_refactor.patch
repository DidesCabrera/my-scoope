+  font-size: 1rem;
+  font-weight: 750;
+  line-height: 1.2;
+}
+
+.proposal-review-kpis--compact {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  margin-bottom: 14px;
+}
+
+/* =========================================================
+   Proposed meals and food rows
+   ========================================================= */
