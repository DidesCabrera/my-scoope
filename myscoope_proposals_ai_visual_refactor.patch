+}
+
+.proposal-list-intro p {
+  margin: 0;
+  font-size: 0.94rem;
+  line-height: 1.45;
+}
+
+.proposal-list-card {
+  display: grid;
+  gap: 14px;
+}
+
+.proposal-list-card__main {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.proposal-list-card__title-block {
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+  min-width: 0;
+}
+
+.proposal-list-card__copy {
+  min-width: 0;
+}
+
+.proposal-list-card__eyebrow,
+.proposal-review-eyebrow {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: 0.72rem;
+  font-weight: 800;
+  letter-spacing: 0.055em;
+  line-height: 1.2;
+  text-transform: uppercase;
+}
+
+.proposal-list-card__title {
+  margin: 2px 0 0;
+  color: var(--text-main);
+  font-size: 1.18rem;
+  font-weight: 700;
+  line-height: 1.2;
+}
+
+.proposal-list-card__subtitle {
+  margin: 4px 0 0;
+  color: var(--text-muted);
+}
+
+.proposal-list-card__metadata {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px 14px;
+  color: var(--text-muted);
+  font-size: 0.86rem;
+}
+
+.proposal-list-card__metadata span {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+}
+
+.proposal-list-card__metadata strong {
+  color: var(--text-main);
+  font-weight: 650;
+}
+
+.proposal-list-card__summary {
+  margin: 0;
+  max-width: 840px;
+  color: var(--text-muted);
+  font-size: 0.94rem;
+  line-height: 1.5;
+}
+
+.proposal-list-card__bottom {
+  gap: 16px;
+}
+
+.proposal-list-card__status-note {
+  color: var(--text-soft);
+  font-size: 0.86rem;
+}
+
+.proposal-link-action {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--interactive-primary);
+  font-size: 0.88rem;
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.proposal-link-action:hover {
+  color: var(--interactive-primary-hover);
+  text-decoration: none;
+}
+
+.proposal-link-action__icon {
+  width: 15px;
+  height: 15px;
+  stroke-width: 2;
+}
+
+.proposal-empty-card {
+  display: flex;
+  align-items: flex-start;
+  gap: 14px;
+}
+
+.proposal-empty-card h3 {
+  margin: 0 0 6px;
+  color: var(--text-main);
+  font-size: 1rem;
+}
+
+.proposal-empty-card p {
+  margin: 0;
+  color: var(--text-muted);
+  line-height: 1.45;
+}
+
+/* =========================================================
+   Shared badges
+   ========================================================= */
+
+.proposal-status-badge,
+.proposal-type-badge {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: fit-content;
+  border-radius: 999px;
+  border: 1px solid var(--border-default);
+  background: var(--surface-card-muted);
+  color: var(--text-muted);
+  font-size: 0.74rem;
+  font-weight: 800;
+  line-height: 1;
+  padding: 7px 10px;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+
+.proposal-type-badge {
+  color: var(--text-main);
+}
+
+.proposal-status-badge--pending,
+.proposal-status-badge--draft,
+.proposal-status-badge--review,
+.proposal-status-badge--reviewable {
+  border-color: color-mix(in srgb, var(--interactive-primary) 28%, transparent);
+  background: color-mix(in srgb, var(--interactive-primary) 10%, var(--surface-card));
+  color: var(--interactive-primary);
+}
+
+.proposal-status-badge--approved {
+  border-color: rgba(34, 197, 94, 0.28);
+  background: rgba(34, 197, 94, 0.12);
+  color: rgb(21, 128, 61);
+}
+
+.proposal-status-badge--applied {
+  border-color: rgba(20, 184, 166, 0.30);
+  background: rgba(20, 184, 166, 0.13);
+  color: rgb(15, 118, 110);
+}
+
+.proposal-status-badge--rejected,
+.proposal-status-badge--cancelled,
+.proposal-status-badge--canceled {
+  border-color: rgba(239, 68, 68, 0.26);
+  background: rgba(239, 68, 68, 0.11);
+  color: rgb(185, 28, 28);
+}
+
+html[data-theme="dark"] .proposal-status-badge--approved {
+  color: rgb(134, 239, 172);
+}
+
+html[data-theme="dark"] .proposal-status-badge--applied {
+  color: rgb(94, 234, 212);
+}
+
+html[data-theme="dark"] .proposal-status-badge--rejected,
+html[data-theme="dark"] .proposal-status-badge--cancelled,
+html[data-theme="dark"] .proposal-status-badge--canceled {
+  color: rgb(252, 165, 165);
+}
+
+/* =========================================================
+   Detail shell and hero
+   ========================================================= */
+
+.proposal-review-shell {
+  display: grid;
+  gap: 16px;
+}
+
+.proposal-review-hero {
+  padding: 18px 22px;
+  border: 1px solid var(--border-soft);
+  border-radius: 22px;
+  background: var(--surface-card);
+  color: var(--text-main);
+}
+
+.proposal-review-hero__main {
+  display: flex;
+  align-items: flex-start;
+  gap: 14px;
+}
+
+.proposal-review-hero__icon {
+  margin-top: 2px;
+}
+
+.proposal-review-hero__copy {
+  min-width: 0;
+}
+
+.proposal-review-title {
+  margin: 3px 0 10px;
+  color: var(--text-main);
+  font-size: clamp(1.32rem, 2vw, 1.75rem);
+  font-weight: 750;
+  line-height: 1.16;
+}
+
+.proposal-review-pills {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.proposal-review-summary {
+  margin: 12px 0 0;
+  max-width: 820px;
+  color: var(--text-muted);
+  font-size: 0.96rem;
+  line-height: 1.52;
+}
+
+/* =========================================================
+   Context
+   ========================================================= */
+
+.proposal-review-context {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 10px;
+}
+
+.proposal-review-context-item {
+  padding: 14px;
+  border: 1px solid var(--border-soft);
+  border-radius: 18px;
+  background: var(--surface-card);
+  color: var(--text-main);
+}
+
+.proposal-review-context-item span {
+  display: block;
+  margin-bottom: 5px;
+  color: var(--text-muted);
+  font-size: 0.74rem;
+  font-weight: 800;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.proposal-review-context-item strong,
+.proposal-review-context-item a {
+  color: var(--text-main);
+  font-size: 0.92rem;
+  font-weight: 750;
+  line-height: 1.25;
+  text-decoration: none;
+}
+
+.proposal-review-context-item a:hover {
+  color: var(--interactive-primary);
+}
+
+/* =========================================================
+   Cards and KPI blocks
+   ========================================================= */
+
+.proposal-review-card {
+  padding: 18px;
+  border: 1px solid var(--border-soft);
+  border-radius: 22px;
+  background: var(--surface-card);
+  color: var(--text-main);
+}
+
+.proposal-review-card-header {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 14px;
+}
+
+.proposal-review-section-title {
+  margin: 3px 0 0;
+  color: var(--text-main);
+  font-size: 1.05rem;
+  font-weight: 750;
+  line-height: 1.25;
+}
+
+.proposal-review-kpis {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: 10px;
+  margin-bottom: 16px;
+}
+
+.proposal-review-kpi {
+  display: grid;
+  gap: 4px;
+  min-width: 0;
+  padding: 12px;
+  border: 1px solid var(--border-soft);
+  border-radius: 16px;
+  background: var(--surface-card-muted);
