+  border: 1px solid var(--panel-row-separator);
+  border-radius: 16px;
+  background: var(--surface-card);
+}
+
+.proposal-review-food-row {
+  display: grid;
+  grid-template-columns: minmax(160px, 2fr) repeat(5, minmax(76px, 1fr));
+  gap: 10px;
+  align-items: center;
+  padding: 12px 14px;
+  border-bottom: 1px solid var(--panel-row-separator);
+  color: var(--text-muted);
+  font-size: 0.88rem;
+}
+
+.proposal-review-food-row:last-child {
